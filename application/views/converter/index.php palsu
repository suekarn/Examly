            if (type === 'lin' || type === 'skw') return num + '/' + den;
            return '\\dfrac' + num + den;
        }
        case 'sSup': return ommlGroup(ommlChild(n, 'e')) + '^' + ommlGroup(ommlChild(n, 'sup'));
        case 'sSub': return ommlGroup(ommlChild(n, 'e')) + '_' + ommlGroup(ommlChild(n, 'sub'));
        case 'sSubSup': return ommlGroup(ommlChild(n, 'e')) + '_' + ommlGroup(ommlChild(n, 'sub')) + '^' + ommlGroup(ommlChild(n, 'sup'));
        case 'sPre': return '{}_' + ommlGroup(ommlChild(n, 'sub')) + '^' + ommlGroup(ommlChild(n, 'sup')) + ommlGroup(ommlChild(n, 'e'));
        case 'rad': {
            const rpr = ommlChild(n, 'radPr');
            const hideEl = rpr && ommlChild(rpr, 'degHide');
            const hide = !!hideEl && ommlVal(hideEl) !== '0' && ommlVal(hideEl) !== 'false';
            const deg = ommlKids(ommlChild(n, 'deg')).trim();
