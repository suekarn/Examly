function ommlChild(el, name) {
    if (!el) return null;
    for (let c = el.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === name) return c;
    return null;
}
function ommlVal(el) {
    if (!el) return null;
    let v = el.getAttributeNS(EQ_NS_M, 'val');
    if (v === null || v === '') v = el.getAttribute('m:val');
    return v;
}
function ommlTextChar(ch) {
    if (OMML_SYMBOLS[ch] !== undefined) return OMML_SYMBOLS[ch];
    if (OMML_GREEK[ch] !== undefined) return OMML_GREEK[ch];
    switch (ch) {
        case '\\': return '\\backslash ';
        case '{': return '\\{';
        case '}': return '\\}';
        case '#': return '\\#';
        case '%': return '\\%';
        case '&': return '\\&';
        case '$': return '\\$';
        case '_': return '\\_';
        case '~': return '\\sim ';
        case '^': return '\\hat{}';
        case ' ': case '\t': case '\n': return '';
    }
