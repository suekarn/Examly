}
function ommlRun(r) {
    let text = '';
    for (let c = r.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === 't') text += c.textContent;
    if (!text) return '';
    const rpr = ommlChild(r, 'rPr');
    const norEl = rpr && ommlChild(rpr, 'nor');
    const nor = !!norEl && ommlVal(norEl) !== '0' && ommlVal(norEl) !== 'false';
    const sty = rpr && ommlChild(rpr, 'sty') ? ommlVal(ommlChild(rpr, 'sty')) : '';
    if (nor) return '\\text{' + ommlPlainText(text) + '}';
    let out = '';
    for (const ch of text) out += ommlTextChar(ch);
    if (!out) return '';
    if ((sty === 'p') && /^[A-Za-z]{2,}$/.test(text.replace(/\s+/g, ''))) return '\\mathrm{' + text.replace(/\s+/g, '') + '}';
    if (sty === 'p' && /^[A-Za-z]$/.test(text)) return '\\mathrm{' + text + '}';
