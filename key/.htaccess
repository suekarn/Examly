# Blokir akses langsung ke file data (berisi kode lisensi & data perangkat).
# admin.php dan check_license.php tetap bisa membacanya lewat PHP.
<FilesMatch "\.(json|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
