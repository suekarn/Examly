async function callCloudflareApi(accountId, apiToken, model, promptText) {
    let endpoint = `https://api.cloudflare.com/client/v4/accounts/${accountId}/ai/run/${model}`;
    let res = await fetch(endpoint, {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${apiToken}`
        },
        body: JSON.stringify({
            messages: [
                { role: "system", content: "You are a helpful assistant that outputs strict JSON." },
                { role: "user", content: promptText }
            ]
        })
    });
    if (!res.ok) throw new Error(`Cloudflare Workers AI ${model} Error Status:${res.status}`);
    let data = await res.json();
    return data.result?.response;
}

async function prosesDanRapikanDenganAI() {
    const container = document.getElementById('inputText');
    if (!parsedData || parsedData.length === 0) parseLocalInstantly(container.innerText);
    if (parsedData.length === 0) return alert('Tidak ada soal yang terdeteksi.');

    let providersChain = [];
    try {
        let chainStr = SERVER_KEYS.chain || localStorage.getItem('AI_PROVIDER_CHAIN') || '["gemini","openai","groq","cerebras","github","openrouter","mistral","cloudflare"]';
        providersChain = typeof chainStr === 'string' ? JSON.parse(chainStr) : chainStr;
    } catch(e) {
        providersChain = ["gemini","openai","groq","cerebras","github","openrouter","mistral","cloudflare"];
    }

    let geminiKeys = getApiKeys('gemini');
    let openaiKeys = getApiKeys('openai');
    let groqKeys = getApiKeys('groq');
    let cerebrasKeys = getApiKeys('cerebras');
    let githubKeys = getApiKeys('github');
    let openRouterKeys = getApiKeys('openrouter');
    let mistralKeys = getApiKeys('mistral');
    let cfAccountId = SERVER_KEYS.cloudflare_account || localStorage.getItem('CUSTOM_CLOUDFLARE_ACCOUNT_ID') || '';
    let cfKeys = getApiKeys('cloudflare_key');

    if (geminiKeys.length === 0 && openaiKeys.length === 0 && groqKeys.length === 0 && cerebrasKeys.length === 0 && githubKeys.length === 0 && openRouterKeys.length === 0 && mistralKeys.length === 0 && cfKeys.length === 0) {
        alert("Harap masukkan minimal 1 API Key di menu Pengaturan!");
        openApiKeyModal();
        return;
    }

    const cached = await lookupConverterCache(true);
    if (cached) {
        alert(`Hasil ${parsedData.length} soal ditemukan di cache. Tidak ada request AI baru.`);
        return;
    }

    activeQuestionFingerprint = await getQuestionFingerprint(parsedData);
    setCacheStatus('<i class="fas fa-sync-alt fa-spin mr-1"></i> Belum ada cache. Menyiapkan proses AI...', 'info');

    const btn = document.getElementById('btnAiAnswer');
    btn.disabled = true;
    btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i> Menganalisis via Multi-AI Engine...`;

    const totalSoal = parsedData.length;
    const batchSize = 10; 
    let hasilAI = [];

    const delay = ms => new Promise(res => setTimeout(res, ms));

    try {
        for (let i = 0; i < totalSoal; i += batchSize) {
            let chunkSoal = parsedData.slice(i, i + batchSize);
            let startNo = i + 1;
            let endNo = Math.min(i + batchSize, totalSoal);
            let percent = Math.round((i / totalSoal) * 100);

            updateAIProgress(percent, `Memproses Soal No. ${startNo} s.d ${endNo} dari${totalSoal}...`);

            let promptText = `Kamu adalah sistem pemroses bank soal. Analisis dan formatkan potongan soal berikut menjadi JSON Array murni. Jika dalam soal terdapat struktur tabel, sertakan struktur tabel tersebut dalam tag HTML <table>...</table> yang bersih di dalam string "question".

Potongan Soal (No ${startNo} - ${endNo}):${JSON.stringify(chunkSoal, null, 2)}

ATURAN KETAT OUTPUT:
1. Kembalikan HANYA JSON Array murni [ ... ].
2. JANGAN tambahkan teks pembuka/penutup, markdown (\`\`\`json), atau keterangan apa pun.
3. Tentukan jenis soal (1=PG Biasa, 2=PG Kompleks, 3=Menjodohkan, 4=Isian, 5=Uraian).
4. Berikan kunci jawaban yang BENAR di field "key" HANYA berupa HURUF KAPITAL TUNGGAL dalam array. Contoh: ["A"] atau ["B"].
5. JANGAN sertakan nomor urut soal di dalam teks "question" (hilangkan "1.", "2.", dst).
6. Pada "options", tuliskan HANYA OPSI YANG ADA SESUAI SOAL ASLI. JANGAN menambahkan opsi jika tidak ada di soal asli!
7. Tuliskan ISI OPSINYA SAJA tanpa huruf "A.", "B.", dst.
8. Pastikan SEMUA teks bersih dari spasi berlebih, spasi tak terlihat (nbsp), dan tab.`;

            let rawString = null;
            let batchSuccess = false;

            for (let prov of providersChain) {
                if (batchSuccess) break;

                if (prov === 'gemini' && geminiKeys.length > 0) {
                    let models = ["gemini-2.5-flash", "gemini-2.5-pro"];
                    for (let key of geminiKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callGeminiApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`Gemini API/Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'openai' && openaiKeys.length > 0) {
                    let models = ["gpt-4o-mini", "gpt-4o"];
                    for (let key of openaiKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callOpenAiApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`OpenAI Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                } 
                else if (prov === 'groq' && groqKeys.length > 0) {
                    let models = ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"];
                    for (let key of groqKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callGroqApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`Groq Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'cerebras' && cerebrasKeys.length > 0) {
                    let models = ["llama-3.3-70b", "llama3.1-8b"];
                    for (let key of cerebrasKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callCerebrasApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`Cerebras Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'github' && githubKeys.length > 0) {
                    let models = ["gpt-4o-mini", "Phi-3.5-mini-instruct", "Llama-3.3-70B-Instruct"];
                    for (let key of githubKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callGithubApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`GitHub Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'openrouter' && openRouterKeys.length > 0) {
                    let models = ["deepseek/deepseek-chat", "meta-llama/llama-3.3-70b-instruct"];
                    for (let key of openRouterKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callOpenRouterApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`OpenRouter Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'mistral' && mistralKeys.length > 0) {
                    let models = ["mistral-small-latest", "mistral-large-latest"];
                    for (let key of mistralKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callMistralApi(key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`Mistral Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
                else if (prov === 'cloudflare' && cfAccountId && cfKeys.length > 0) {
                    let models = ["@cf/meta/llama-3.3-70b-instruct-fp8-fast", "@cf/meta/llama-3.1-8b-instruct"];
                    for (let key of cfKeys) {
                        if (batchSuccess) break;
                        for (let mod of models) {
                            try {
                                rawString = await callCloudflareApi(cfAccountId, key, mod, promptText);
                                if (rawString) { batchSuccess = true; break; }
                            } catch (e) {
                                console.warn(`Cloudflare Model ${mod} gagal/limit:`, e.message);
                            }
                        }
                    }
                }
            }

            if (!batchSuccess || !rawString) {
                throw new Error(`Semua Provider & API Key yang dikonfigurasi mengalami limit atau error pada soal No ${startNo}-${endNo}. Silakan periksa kembali API Key Anda.`);
            }

            let firstBracket = rawString.indexOf('[');
            let lastBracket = rawString.lastIndexOf(']');

            if (firstBracket === -1 || lastBracket === -1) {
                throw new Error(`Format JSON tidak valid pada No. ${startNo}-${endNo}`);
            }

            let cleanJsonString = rawString.substring(firstBracket, lastBracket + 1);
            hasilAI = hasilAI.concat(JSON.parse(cleanJsonString));

            if (i + batchSize < totalSoal) {
                await delay(1000);
            }
        }

        updateAIProgress(100, `Selesai! Berhasil menganalisis seluruh ${totalSoal} soal.`);

        parsedData = hasilAI;
        parsedData.forEach((item, index) => { 
            item.number = index + 1; 
            item.question = String(item.question || '').replace(/^\d+[\.\)]\s*/, '').trim();
            item.images = item.images || []; 
        });
        isAiProcessed = true;
        cacheLoaded = true;

        await saveConverterCache(activeQuestionFingerprint, parsedData);

        setTimeout(() => {
            renderPreview();
            alert(`Selesai! Berhasil memproses ${parsedData.length} soal menggunakan Rotasi Multi-AI Engine.`);
        }, 400);

    } catch (err) {
        console.error(err);
        alert('Gagal memproses soal: ' + err.message);
        renderPreview();
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-robot mr-2"></i> Jalankan AI Generator & Kunci Jawaban Otomatis ✨';
    }
}

function renderPreview() {
    const container = document.getElementById('previewRenderArea');
    const badge = document.getElementById('countBadge');
    
    if (isAiProcessed) {
        badge.className = "badge badge-success px-2 py-1";
        badge.innerText = parsedData.length + ' Soal Terverifikasi AI';
    } else {
        badge.className = "badge badge-warning px-2 py-1 text-dark";
        badge.innerText = parsedData.length + ' Soal Terdeteksi (Draft)';
    }

    if (parsedData.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-5"><i class="fas fa-magic fa-3x mb-3 text-teal d-block"></i>Tempelkan teks bank soal di sebelah kiri atau unggah dokumen.</div>';
        return;
    }

    let html = '';
    const typeBadges = {
        1: '<span class="badge badge-primary badge-type">Pilihan Ganda (PG 1)</span>',
        2: '<span class="badge badge-info badge-type">PG Kompleks (PG 2)</span>',
        3: '<span class="badge badge-warning badge-type text-dark">Menjodohkan</span>',
        4: '<span class="badge badge-success badge-type">Isian Singkat</span>',
        5: '<span class="badge badge-danger badge-type">Uraian / Essai</span>'
    };

    parsedData.forEach((item) => {
        let cleanQuestion = String(item.question || '').replace(/^\d+[\.\)]\s*/, '').trim();
        html += `<div class="card mb-3 shadow-sm border">
            <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="font-weight-bold text-teal">No. ${item.number}</span>
                ${isAiProcessed ? (typeBadges[item.jenis] || '') : '<span class="badge badge-secondary badge-type">Drafting</span>'}
            </div>
            <div class="card-body p-3">
                <div class="mb-2 font-weight-bold text-dark">${cleanQuestion}</div>`;

        if (item.options) {
            html += '<div class="pl-2">';
            item.options.forEach((opt, oIdx) => {
                let char = String.fromCharCode(65 + oIdx);
                let isCorrect = item.key && Array.isArray(item.key) && item.key.some(k => String(k).trim().toUpperCase() === char);
                let cleanOptText = escapeHtml(opt).replace(/^[a-eA-E1-5][.)]\s*/, '').trim();

                html += `<div class="${isCorrect ? 'text-success font-weight-bold' : 'text-muted'} mb-1">
                    <small><b>${char}.</b> ${cleanOptText} ${isCorrect ? '<i class="fas fa-check-circle text-success ml-1"></i> <b>(Kunci AI)</b>' : ''}</small>
                </div>`;
            });
            html += '</div>';
        }
        html += `</div></div>`;
    });

    container.innerHTML = html;
}

// CONVERT TO WORD GARUDA - RESPONSIVE LOADING, LANDSCAPE PERMANEN & TABEL TURUN
async function convertToWordGaruda() {
    if (!parsedData || parsedData.length === 0) {
        alert("Belum ada soal untuk diunduh!");
        return;
    }

    if (typeof docx === 'undefined' || typeof saveAs === 'undefined') {
        alert("Library docx.js / FileSaver belum siap.");
        return;
    }

    const btnDownload = document.getElementById('btnDownloadWord');
    const originalText = btnDownload.innerHTML;
    btnDownload.disabled = true;
    btnDownload.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i> Meng-generate File Word...`;

    await new Promise(resolve => setTimeout(resolve, 100));

    try {
        const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, WidthType, ShadingType, BorderStyle, AlignmentType, VerticalAlign } = docx;

        const FONT_NAME = "Calibri";
        const FONT_SIZE = 24; 

        const tableBorders = {
            top: { style: BorderStyle.SINGLE, size: 4, color: "000000" },
            bottom: { style: BorderStyle.SINGLE, size: 4, color: "000000" },
            left: { style: BorderStyle.SINGLE, size: 4, color: "000000" },
            right: { style: BorderStyle.SINGLE, size: 4, color: "000000" },
            insideHorizontal: { style: BorderStyle.SINGLE, size: 4, color: "000000" },
            insideVertical: { style: BorderStyle.SINGLE, size: 4, color: "000000" }
        };

        const tableRows = [];

        // Header Row
        const headerRow = new TableRow({
            cantSplit: true,
            children: [
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "NO", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 5, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER }),
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "SOAL", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 45, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER }),
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "JENIS", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 8, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER }),
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "OPSI", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 7, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER }),
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "JAWABAN", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 25, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER }),
                new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "KUNCI", bold: true, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], width: { size: 10, unit: WidthType.PERCENTAGE }, shading: { fill: "B4C6E7", type: ShadingType.CLEAR }, verticalAlign: VerticalAlign.CENTER })
            ]
        });
        tableRows.push(headerRow);

        function parseHtmlTableToDocx(htmlString) {
            let docxElements = [];
            let tempDiv = document.createElement('div');
            tempDiv.innerHTML = htmlString;

            let tableEl = tempDiv.querySelector('table');
            if (tableEl) {
                let clone = tempDiv.cloneNode(true);
                let t = clone.querySelector('table');
                if (t) t.remove();
                let textBefore = clone.innerText.replace(/^\d+[\.\)]\s*/, '').trim();
                if (textBefore) docxElements.push(new Paragraph({ children: [new TextRun({ text: textBefore, font: FONT_NAME, size: FONT_SIZE })] }));

                let innerRows = [];
                let rows = tableEl.querySelectorAll('tr');
                rows.forEach(tr => {
                    let cells = [];
                    let cols = tr.querySelectorAll('th, td');
                    cols.forEach(td => {
                        cells.push(new TableCell({
                            children: [new Paragraph({ children: [new TextRun({ text: td.innerText.trim(), font: FONT_NAME, size: FONT_SIZE })] })],
                            borders: tableBorders
                        }));
                    });
                    if (cells.length > 0) innerRows.push(new TableRow({ children: cells }));
                });

                if (innerRows.length > 0) {
                    docxElements.push(new Table({ rows: innerRows, width: { size: 100, unit: WidthType.PERCENTAGE } }));
                }
            } else {
                let cleanText = tempDiv.innerText.replace(/^\d+[\.\)]\s*/, '').trim();
                docxElements.push(new Paragraph({ children: [new TextRun({ text: cleanText, font: FONT_NAME, size: FONT_SIZE })] }));
            }

            return docxElements;
        }

        parsedData.forEach((item) => {
            let totalOptions = (item.options && item.options.length > 0) ? item.options.length : 5;
            let cleanQuestionText = String(item.question || '').replace(/^\d+[\.\)]\s*/, '').trim();
            let soalChildren = parseHtmlTableToDocx(cleanQuestionText);

            for (let oIdx = 0; oIdx < totalOptions; oIdx++) {
                let char = String.fromCharCode(65 + oIdx);
                let isCorrect = item.key && Array.isArray(item.key) && item.key.some(k => String(k).trim().toUpperCase() === char);
                let optText = (item.options && item.options[oIdx]) ? item.options[oIdx].replace(/^[a-eA-E1-5][.)]\s*/, '').trim() : '';

                let cells = [];

                if (oIdx === 0) {
                    cells.push(
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: String(item.number), font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], rowSpan: totalOptions, verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: soalChildren, rowSpan: totalOptions, verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: String(item.jenis || 1), font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], rowSpan: totalOptions, verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: char, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: optText, font: FONT_NAME, size: FONT_SIZE })] })], verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: isCorrect ? "v" : "", font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], verticalAlign: VerticalAlign.CENTER })
                    );
                } else {
                    cells.push(
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: char, font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: optText, font: FONT_NAME, size: FONT_SIZE })] })], verticalAlign: VerticalAlign.CENTER }),
                        new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: isCorrect ? "v" : "", font: FONT_NAME, size: FONT_SIZE })], alignment: AlignmentType.CENTER })], verticalAlign: VerticalAlign.CENTER })
                    );
                }

                tableRows.push(new TableRow({ children: cells }));
            }
        });

        const doc = new Document({
            styles: {
                default: {
                    document: {
                        run: {
                            font: FONT_NAME,
                            size: FONT_SIZE
                        }
                    }
                }
            },
            sections: [{
                properties: {
                    page: {
                        orientation: docx.PageOrientation.LANDSCAPE,
                        size: {
                            width: 16838,  
                            height: 11906  
                        },
                        margin: {
                            top: 1000,
                            bottom: 1000,
                            left: 1000,
                            right: 1000
                        }
                    }
                },
                children: [
                    new Paragraph({
                        children: [new TextRun({ text: "I. Soal Pilihan Ganda (satu jawaban benar)", bold: true, font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 100
                    }),
                    new Paragraph({
                        children: [new TextRun({ text: "- Jenis Pilihan Ganda (PG 1) untuk pilihan ganda yang sudah ditentukan pilihan opsinya, misal 4 opsi (A,B,C,D) atau 5 opsi (A,B,C,D,E).", font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [
                            new TextRun({ text: "- Kolom jenis harus diisi angka ", font: FONT_NAME, size: FONT_SIZE }),
                            new TextRun({ text: "1", bold: true, font: FONT_NAME, size: FONT_SIZE })
                        ],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [new TextRun({ text: "- Biarkan OPSI JAWABAN kosong jika ada opsi yang tidak digunakan.", font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [new TextRun({ text: "- NOMOR soal yang tidak digunakan bisa dihapus atau dibiarkan kosong.", font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [new TextRun({ text: "- Soal dan jawaban bisa disisipi gambar", color: "00B050", font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [new TextRun({ text: "- KUNCI hanya diisi satu jawaban.", font: FONT_NAME, size: FONT_SIZE })],
                        spaceAfter: 40
                    }),
                    new Paragraph({
                        children: [
                            new TextRun({ text: "- Beri tanda v pada opsi jawaban benar, (", font: FONT_NAME, size: FONT_SIZE }),
                            new TextRun({ text: "v huruf kecil atau V huruf besar", bold: true, font: FONT_NAME, size: FONT_SIZE }),
                            new TextRun({ text: ").", font: FONT_NAME, size: FONT_SIZE })
                        ]
                    }),
                    new Paragraph({ children: [], spaceAfter: 150 }),
                    new Table({
                        rows: tableRows,
                        borders: tableBorders,
                        width: { size: 100, unit: WidthType.PERCENTAGE }
                    })
                ]
            }]
        });

        const blob = await Packer.toBlob(doc);
        saveAs(blob, "Soal_Converter.docx");

    } catch (err) {
        alert("Gagal mengunduh file Word: " + err.message);
    } finally {
        btnDownload.disabled = false;
        btnDownload.innerHTML = originalText;
    }
}

function clearAll() {
    document.getElementById('inputText').innerHTML = '';
    document.getElementById('btnAiAnswer').style.display = 'none';
    parsedData = [];
    isAiProcessed = false;
    cacheLoaded = false;
    activeQuestionFingerprint = '';
    setCacheStatus('', 'muted');
    renderPreview();
}

function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
</script>