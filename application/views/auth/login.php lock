                    if (!empty($ids_bank)) {
                        $rows_bank = $this->db->select('id_bank, bank_kode')
                                              ->where_in('id_bank', $ids_bank)
                                              ->get('cbt_bank_soal')->result_array();
                        foreach ($rows_bank as $b) {
