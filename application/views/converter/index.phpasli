<script>
const SERVER_KEYS = <?= json_encode($savedKeys ?? ['gemini'=>'','openai'=>'','groq'=>'','cerebras'=>'','github'=>'','openrouter'=>'','mistral'=>'','cloudflare_account'=>'','cloudflare_key'=>'','chain'=>'["gemini","openai","groq","cerebras","github","openrouter","mistral","cloudflare"]']) ?>;

function toggleVisibility(inputId, btn) {
    let input = document.getElementById(inputId);
    let icon = btn.querySelector('i');
    if (input.type === "password") {
        input.type = "text";
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        input.type = "password";
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}

function copyToClipboard(inputId, btn) {
    let input = document.getElementById(inputId);
    if (!input.value.trim()) {
        alert("Key/Token masih kosong, tidak ada yang disalin.");
        return;
    }

    navigator.clipboard.writeText(input.value.trim()).then(() => {
        let icon = btn.querySelector('i');
        icon.className = 'fas fa-check text-success';
        btn.classList.add('border-success');

        setTimeout(() => {
            icon.className = 'fas fa-copy';
            btn.classList.remove('border-success');
        }, 1500);
    }).catch(err => {
        input.select();
        document.execCommand('copy');
        alert("Berhasil disalin!");
    });
}

function openApiKeyModal() {
    let geminiVal = SERVER_KEYS.gemini || localStorage.getItem('CUSTOM_GEMINI_KEY') || '';
    let openaiVal = SERVER_KEYS.openai || localStorage.getItem('CUSTOM_OPENAI_KEY') || '';
    let groqVal = SERVER_KEYS.groq || localStorage.getItem('CUSTOM_GROQ_KEY') || '';
    let cerebrasVal = SERVER_KEYS.cerebras || localStorage.getItem('CUSTOM_CEREBRAS_KEY') || '';
    let githubVal = SERVER_KEYS.github || localStorage.getItem('CUSTOM_GITHUB_KEY') || '';
    let openRouterVal = SERVER_KEYS.openrouter || localStorage.getItem('CUSTOM_OPENROUTER_KEY') || '';
    let mistralVal = SERVER_KEYS.mistral || localStorage.getItem('CUSTOM_MISTRAL_KEY') || '';
    let cfAccountVal = SERVER_KEYS.cloudflare_account || localStorage.getItem('CUSTOM_CLOUDFLARE_ACCOUNT_ID') || '';
    let cfKeyVal = SERVER_KEYS.cloudflare_key || localStorage.getItem('CUSTOM_CLOUDFLARE_KEY') || '';
    let chainVal = SERVER_KEYS.chain || localStorage.getItem('AI_PROVIDER_CHAIN') || '["gemini","openai","groq","cerebras","github","openrouter","mistral","cloudflare"]';

    document.getElementById('inputGeminiKey').value = geminiVal;
    document.getElementById('inputOpenaiKey').value = openaiVal;
    document.getElementById('inputGroqKey').value = groqVal;
    document.getElementById('inputCerebrasKey').value = cerebrasVal;
    document.getElementById('inputGithubKey').value = githubVal;
    document.getElementById('inputOpenRouterKey').value = openRouterVal;
    document.getElementById('inputMistralKey').value = mistralVal;
    document.getElementById('inputCloudflareAccountId').value = cfAccountVal;
    document.getElementById('inputCloudflareKey').value = cfKeyVal;

    let chain = [];
    try { 
        chain = typeof chainVal === 'string' ? JSON.parse(chainVal) : chainVal; 
    } catch(e) { 
        chain = ["gemini","openai","groq","cerebras","github","openrouter","mistral","cloudflare"]; 
    }

    document.querySelectorAll('.provider-chain-item').forEach(cb => {
        cb.checked = chain.includes(cb.value);
    });

    if (typeof $ !== 'undefined') $('#apiKeyModal').modal('show');
}

async function saveApiKeyModal() {
    let geminiVal = document.getElementById('inputGeminiKey').value.trim();
    let openaiVal = document.getElementById('inputOpenaiKey').value.trim();
    let groqVal = document.getElementById('inputGroqKey').value.trim();
    let cerebrasVal = document.getElementById('inputCerebrasKey').value.trim();
    let githubVal = document.getElementById('inputGithubKey').value.trim();
    let openRouterVal = document.getElementById('inputOpenRouterKey').value.trim();
    let mistralVal = document.getElementById('inputMistralKey').value.trim();
    let cfAccountVal = document.getElementById('inputCloudflareAccountId').value.trim();
    let cfKeyVal = document.getElementById('inputCloudflareKey').value.trim();

    let selectedProviders = [];
    document.querySelectorAll('.provider-chain-item:checked').forEach(cb => {
        selectedProviders.push(cb.value);
    });
    let chainJsonStr = JSON.stringify(selectedProviders);

    let formData = new FormData();
    formData.append('action', 'save_keys');
    formData.append('gemini', geminiVal);
    formData.append('openai', openaiVal);
    formData.append('groq', groqVal);
    formData.append('cerebras', cerebrasVal);
    formData.append('github', githubVal);
    formData.append('openrouter', openRouterVal);
    formData.append('mistral', mistralVal);
    formData.append('cloudflare_account', cfAccountVal);
    formData.append('cloudflare_key', cfKeyVal);
    formData.append('chain', chainJsonStr);

    let csrfName = '<?= $this->security->get_csrf_token_name(); ?>';
    let csrfHash = '<?= $this->security->get_csrf_hash(); ?>';
    if (csrfName) formData.append(csrfName, csrfHash);

    try {
        let res = await fetch(window.location.href, {
            method: 'POST',
            body: formData
        });

        let result = await res.json();

        if (result.status === 'success') {
            localStorage.setItem('CUSTOM_GEMINI_KEY', geminiVal);
            localStorage.setItem('CUSTOM_OPENAI_KEY', openaiVal);
            localStorage.setItem('CUSTOM_GROQ_KEY', groqVal);
            localStorage.setItem('CUSTOM_CEREBRAS_KEY', cerebrasVal);
            localStorage.setItem('CUSTOM_GITHUB_KEY', githubVal);
            localStorage.setItem('CUSTOM_OPENROUTER_KEY', openRouterVal);
            localStorage.setItem('CUSTOM_MISTRAL_KEY', mistralVal);
            localStorage.setItem('CUSTOM_CLOUDFLARE_ACCOUNT_ID', cfAccountVal);
            localStorage.setItem('CUSTOM_CLOUDFLARE_KEY', cfKeyVal);
            localStorage.setItem('AI_PROVIDER_CHAIN', chainJsonStr);

            alert("API Key berhasil disimpan permanen di Database Server!");
            if (typeof $ !== 'undefined') $('#apiKeyModal').modal('hide');
            location.reload();
        } else {
            alert("Gagal menyimpan: " + result.message);
        }
    } catch (err) {
        alert("Gagal koneksi ke server: " + err.message);
    }
}

function getApiKeys(provider) {
    let keyStr = SERVER_KEYS[provider] || localStorage.getItem(`CUSTOM_${provider.toUpperCase()}_KEY`) || '';
    if (!keyStr) return [];
    return keyStr.split(',').map(k => k.trim()).filter(k => k.length > 0);
}

if (typeof window !== 'undefined' && 'pdfjsLib' in window) {
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
}

let parsedData = [];
let isAiProcessed = false;
let activeQuestionFingerprint = '';
let cacheLoaded = false;
let cacheLookupTimer = null;
let cacheLookupInProgress = false;

function normalizeForFingerprint(value) {
    return String(value ?? '')
        .replace(/\r\n/g, '\n')
        .replace(/\r/g, '\n')
        .replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

function getFingerprintSource(data) {
    return (data || []).map(item => ({
        question: normalizeForFingerprint(item.question),
        options: Array.isArray(item.options) ? item.options.map(normalizeForFingerprint) : [],
        jenisDraft: item.jenis ? String(item.jenis) : '',
        answer: item.answer ? normalizeForFingerprint(item.answer) : ''
    }));
}

async function sha256Hex(text) {
    if (window.crypto && window.crypto.subtle) {
        const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return Array.from(new Uint8Array(buffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    let h1 = 0x811c9dc5, h2 = 0x01000193;
    for (let i = 0; i < text.length; i++) {
        const c = text.charCodeAt(i);
        h1 ^= c; h1 = Math.imul(h1, 16777619);
        h2 ^= c + i; h2 = Math.imul(h2, 16777619);
    }
    return (h1 >>> 0).toString(16).padStart(8,'0') + (h2 >>> 0).toString(16).padStart(8,'0') +
           (text.length >>> 0).toString(16).padStart(8,'0') + '00000000000000000000000000000000';
}

async function getQuestionFingerprint(data = parsedData) {
    const canonical = JSON.stringify(getFingerprintSource(data));
    return await sha256Hex(canonical);
}

function setCacheStatus(message, type = 'muted') {
    const el = document.getElementById('cacheStatus');
    if (!el) return;
    el.className = `small text-${type} mb-2`;
    el.style.display = message ? 'block' : 'none';
    el.innerHTML = message;
}

function normalizeAiResult(data) {
    if (!Array.isArray(data)) return [];
    return data.map((item, index) => {
        item = item || {};
        item.number = index + 1;
        item.question = String(item.question || '').replace(/^\d+[\.\)]\s*/, '').trim();
        item.images = Array.isArray(item.images) ? item.images : [];
        return item;
    });
}

async function lookupConverterCache(showMiss = false) {
    if (cacheLookupInProgress || !parsedData || parsedData.length === 0 || isAiProcessed) return false;
    cacheLookupInProgress = true;
    try {
        const fingerprint = await getQuestionFingerprint(parsedData);
        activeQuestionFingerprint = fingerprint;
        const fd = new FormData();
        fd.append('action', 'cache_lookup');
        fd.append('fingerprint', fingerprint);
        const csrfName = '<?= $this->security->get_csrf_token_name(); ?>';
        const csrfHash = '<?= $this->security->get_csrf_hash(); ?>';
        if (csrfName) fd.append(csrfName, csrfHash);

        const res = await fetch(window.location.href, { method: 'POST', body: fd });
        const result = await res.json();
        if (result.status === 'hit' && Array.isArray(result.data) && result.data.length) {
            parsedData = normalizeAiResult(result.data);
            isAiProcessed = true;
            cacheLoaded = true;
            document.getElementById('btnAiAnswer').style.display = 'none';
            setCacheStatus(`<i class="fas fa-database mr-1"></i> Hasil ditemukan di cache. ${result.question_count || parsedData.length} soal siap diunduh tanpa convert ulang. <span class="text-muted">${result.cached_at || ''}</span>`, 'success');
            renderPreview();
            return true;
        }
        if (showMiss) setCacheStatus('<i class="fas fa-info-circle mr-1"></i> Belum ada hasil tersimpan. Klik AI Generator untuk memproses.', 'muted');
    } catch (e) {
        console.warn('Cache lookup gagal:', e);
        if (showMiss) setCacheStatus('<i class="fas fa-exclamation-triangle mr-1"></i> Cache server tidak dapat diperiksa. Anda tetap dapat menjalankan AI.', 'warning');
    } finally {
        cacheLookupInProgress = false;
    }
    return false;
}

function scheduleCacheLookup() {
    clearTimeout(cacheLookupTimer);
    cacheLookupTimer = setTimeout(() => lookupConverterCache(false), 900);
}

async function saveConverterCache(fingerprint, data) {
    if (!fingerprint || !Array.isArray(data) || !data.length) return false;
    try {
        const fd = new FormData();
        fd.append('action', 'cache_save');
        fd.append('fingerprint', fingerprint);
        fd.append('payload', JSON.stringify(data));
        const csrfName = '<?= $this->security->get_csrf_token_name(); ?>';
        const csrfHash = '<?= $this->security->get_csrf_hash(); ?>';
        if (csrfName) fd.append(csrfName, csrfHash);
        const res = await fetch(window.location.href, { method: 'POST', body: fd });
        const result = await res.json();
        if (result.status === 'success') {
            setCacheStatus(`<i class="fas fa-database mr-1"></i> Hasil AI tersimpan. Import ulang soal yang sama akan menggunakan cache tanpa convert ulang.`, 'success');
            return true;
        }
    } catch (e) {
        console.warn('Cache save gagal:', e);
    }
    return false;
}

const inputArea = document.getElementById('inputText');
if (inputArea) {
    inputArea.addEventListener('paste', function(e) {
        let clipboardData = e.clipboardData || window.clipboardData;
        if (!clipboardData) return;
        let hasImage = false;

        if (clipboardData.items) {
            for (let i = 0; i < clipboardData.items.length; i++) {
                if (clipboardData.items[i].type.indexOf('image') !== -1) {
                    e.preventDefault();
                    hasImage = true;
                    let blob = clipboardData.items[i].getAsFile();
                    let reader = new FileReader();
                    reader.onload = function(event) { insertImageToInput(event.target.result); };
                    reader.readAsDataURL(blob);
                }
            }
        }
        if (!hasImage) {
            let textData = clipboardData.getData('text/plain');
            if (textData) {
                e.preventDefault();
                textData = textData.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]/g, ' ');
                document.execCommand('insertText', false, textData);
            }
        }
        setTimeout(() => autoCleanAndParse(), 100);
    });
}

function insertImageToInput(base64Src) {
    let imgHTML = `<br><img src="${base64Src}" style="max-width:220px; display:block; margin:5px 0;"><br>`;
    document.execCommand('insertHTML', false, imgHTML);
    autoCleanAndParse();
}

function showProgressState(message) {
    const container = document.getElementById('previewRenderArea');
    container.innerHTML = `
        <div class="text-center text-muted py-5">
            <i class="fas fa-spinner fa-spin fa-3x mb-3 text-teal d-block"></i>
            <h6 class="font-weight-bold text-dark">${message}</h6>
            <small class="text-muted">Mohon tunggu, proses mengekstrak file...</small>
        </div>`;
}

async function handleFileUpload(input) {
    const file = input.files[0];
    if (!file) return;

    const ext = file.name.split('.').pop().toLowerCase();
    const container = document.getElementById('inputText');
    
    showProgressState("Mengekstrak Dokumen " + ext.toUpperCase() + "...");
    container.innerText = "Sedang mengekstrak berkas, mohon tunggu...";
    isAiProcessed = false; 

    let reader = new FileReader();

    if (ext === 'docx') {
        if (typeof mammoth === 'undefined') {
            alert("Library Mammoth.js belum siap.");
            container.innerText = "";
            renderPreview();
            return;
        }

        reader.onload = async function(e) {
            try {
                let result = await mammoth.convertToHtml({ arrayBuffer: e.target.result });
                if (result.value && result.value.trim() !== "") {
                    let tempDiv = document.createElement('div');
                    tempDiv.innerHTML = result.value;

                    let ols = tempDiv.querySelectorAll('ol, ul');
                    ols.forEach(ol => {
                        let parentOl = ol.parentElement.closest('ol, ul');
                        let lis = ol.querySelectorAll('li');

                        lis.forEach((li, index) => {
                            let p = document.createElement('p');
                            if (parentOl || lis.length <= 5) {
                                let prefix = String.fromCharCode(97 + (index % 26)) + ". ";
                                p.innerHTML = prefix + li.innerHTML;
                            } else {
                                let prefix = (index + 1) + ". ";
                                p.innerHTML = prefix + li.innerHTML;
                            }
                            li.parentNode.replaceChild(p, li);
                        });
                    });

                    let cleanText = tempDiv.innerText || tempDiv.textContent;
                    cleanText = cleanText.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]/g, ' ');
                    cleanText = cleanText.replace(/\s+/g, ' ');
                    
                    cleanText = cleanText.replace(/\s+([a-eA-E][\.\)]\s*)/g, '\n$1 ');
                    cleanText = cleanText.replace(/\s+(\d{1,3}[\.\)]\s*)/g, '\n\n$1 ');

                    container.innerText = cleanText.trim();
                    
                    parsedData = [];
                    parseLocalInstantly(cleanText);
                    scheduleCacheLookup();
                } else {
                    alert("Teks dokumen kosong atau tidak terbaca.");
                    container.innerText = "";
                    renderPreview();
                }
            } catch (err) { 
                alert("Gagal membaca berkas Word: " + err.message); 
                container.innerText = "";
                renderPreview();
            }
        };
        reader.readAsArrayBuffer(file);

    } else if (ext === 'pdf') {
        if (typeof pdfjsLib === 'undefined') {
            alert("Library PDF.js belum siap.");
            container.innerText = "";
            renderPreview();
            return;
        }

        reader.onload = function(e) {
            let typedarray = new Uint8Array(e.target.result);
            pdfjsLib.getDocument({ data: typedarray }).promise.then(async function(pdf) {
                let maxPages = pdf.numPages;
                let fullText = "";
                
                for (let j = 1; j <= maxPages; j++) {
                    try {
                        showProgressState(`Mengekstrak PDF (Halaman ${j} dari${maxPages})...`);
                        let page = await pdf.getPage(j);
                        let tokenizedText = await page.getTextContent();
                        let pageText = "";
                        let lastY = null;
                        
                        for (let item of tokenizedText.items) {
                            if (lastY !== null && Math.abs(item.transform[5] - lastY) > 5) {
                                pageText += "\n";
                            }
                            pageText += item.str + " ";
                            lastY = item.transform[5];
                        }
                        fullText += pageText + "\n\n";
                    } catch (pageErr) {
                        console.warn(pageErr);
                    }
                }
                
                if (fullText.trim() !== "") {
                    container.innerText = fullText.trim();
                    parsedData = [];
                    parseLocalInstantly(fullText);
                    scheduleCacheLookup();
                } else {
                    alert("PDF tidak memiliki layer teks.");
                    container.innerText = "";
                    renderPreview();
                }
            }).catch(err => {
                alert("Gagal membaca PDF: " + err.message);
                container.innerText = "";
                renderPreview();
            });
        };
        reader.readAsArrayBuffer(file);
    }
    input.value = '';
}

function uploadBatchImages(input) {
    if (input.files && input.files.length > 0) {
        Array.from(input.files).forEach(file => {
            let reader = new FileReader();
            reader.onload = (e) => insertImageToInput(e.target.result);
            reader.readAsDataURL(file);
        });
    }
    input.value = '';
}

function autoCleanAndParse() {
    let container = document.getElementById('inputText');
    let content = container.innerHTML.trim();
    let hasContent = content.length > 0;

    if (cacheLoaded) {
        cacheLoaded = false;
        isAiProcessed = false;
        activeQuestionFingerprint = '';
        setCacheStatus('', 'muted');
    }

    document.getElementById('btnAiAnswer').style.display = hasContent ? 'block' : 'none';
    
    if (!hasContent) {
        parsedData = [];
        isAiProcessed = false;
        activeQuestionFingerprint = '';
        setCacheStatus('', 'muted');
        renderPreview();
    } else {
        if (!isAiProcessed) {
            parseLocalInstantly(container.innerText);
            scheduleCacheLookup();
        }
    }
}

function parseLocalInstantly(text) {
    let rawText = text.trim();
    if (!rawText) {
        parsedData = [];
        renderPreview();
        return;
    }

    rawText = rawText.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]/g, ' '); 
    rawText = rawText.replace(/\r\n/g, '\n').replace(/\r/g, '\n');

    rawText = rawText.replace(/^(?:BERILAH\s+TANDA\s+SILANG[^\n]*|MATA\s+PELAJARAN[^\n]*|PENILAIAN\s+AKHIR[^\n]*|TAHUN\s+PELAJARAN[^\n]*|NAMA\s*:[^\n]*)\n+/gi, '');

    if (!/^\d{1,3}[\.\)]/.test(rawText)) {
        rawText = "1. " + rawText;
    }

    rawText = rawText.replace(/\s+([a-eA-E][\.\)]\s*)/g, '\n$1 ');
    rawText = rawText.replace(/\s+(\d{1,3}[\.\)]\s*)/g, '\n\n$1 ');

    let lines = rawText.split('\n');
    let processedText = "";

    lines.forEach(line => {
        let trimmed = line.trim();
        if (/^\d{1,3}[\.\)]\s*/.test(trimmed)) {
            processedText += '\n===SOAL===\n' + trimmed + '\n';
        } else {
            processedText += line + '\n';
        }
    });

    let rawBlocks = processedText.split('===SOAL===');
    let items = [];
    let realNumberCounter = 1;

    rawBlocks.forEach(block => {
        let cleanBlock = block.trim();
        if (cleanBlock.length > 3) {
            let parsedObj = extractQuestionAndOptions(cleanBlock, realNumberCounter);
            if (parsedObj && parsedObj.question) {
                items.push(parsedObj);
                realNumberCounter++;
            }
        }
    });

    if (items.length > 0) {
        parsedData = items;
        renderPreview();
    }
}

function extractQuestionAndOptions(chunkText, num) {
    if (!chunkText) return null;

    let cleanText = chunkText.trim();
    cleanText = cleanText.replace(/^\d{1,3}[\.\)]\s*/, '').trim();

    let optRegex = /(?:\n|^)\s*([a-eA-E])[\.\)]\s*/g;
    let matches = [];
    let m;

    while ((m = optRegex.exec(cleanText)) !== null) {
        matches.push({
            index: m.index,
            fullMatchLength: m[0].length
        });
    }

    let questionText = "";
    let options = [];

    if (matches.length > 0) {
        questionText = cleanText.substring(0, matches[0].index).trim();

        let limitOptions = Math.min(matches.length, 5);
        for (let i = 0; i < limitOptions; i++) {
            let start = matches[i].index + matches[i].fullMatchLength;
            let end = (i + 1 < matches.length) ? matches[i + 1].index : cleanText.length;
            
            let optVal = cleanText.substring(start, end).trim().replace(/\s+/g, ' ');
            optVal = optVal.replace(/^[a-eA-E1-5][\.\)]\s*/, '').trim();

            if (optVal) {
                options.push(optVal);
            }
        }
    } else {
        questionText = cleanText;
    }

    questionText = questionText.replace(/\n+/g, ' ').replace(/\s+/g, ' ').trim();

    return {
        number: num,
        question: questionText,
        jenis: options.length > 0 ? 1 : 5,
        options: options.length > 0 ? options : null,
        key: null
    };
}

function updateAIProgress(percent, message) {
    const container = document.getElementById('previewRenderArea');
    container.innerHTML = `
        <div class="text-center py-5 px-4">
            <i class="fas fa-brain fa-spin fa-3x mb-3 text-teal"></i>
            <h5 class="font-weight-bold text-dark">${percent}%</h5>
            <p class="text-muted font-weight-bold mb-3" style="font-size: 14px;">${message}</p>
            <div class="progress shadow-sm" style="height: 15px; border-radius: 10px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-teal" 
                     role="progressbar" style="width: ${percent}%;"></div>
            </div>
            <small class="text-muted mt-2 d-block">Memproses analisis kunci jawaban via Multi-AI Engine...</small>
        </div>`;
}

async function callGeminiApi(apiKey, model, promptText) {
    let endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;
    let res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            contents: [{ parts: [{ text: promptText }] }],
            generationConfig: { temperature: 0.1, responseMimeType: "application/json" }
        })
    });
    if (!res.ok) throw new Error(`Gemini ${model} Error Status:${res.status}`);
    let data = await res.json();
    return data.candidates?.[0]?.content?.parts?.[0]?.text;
}

async function callOpenAiApi(apiKey, model, promptText) {
    let res = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${apiKey}`
        },
        body: JSON.stringify({
            model: model,
            messages: [{ role: "user", content: promptText }],
            temperature: 0.1,
            response_format: { type: "json_object" }
        })
    });
    if (!res.ok) throw new Error(`OpenAI ${model} Error Status:${res.status}`);
    let data = await res.json();
    return data.choices?.[0]?.message?.content;
}

