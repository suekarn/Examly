    </style>
</head>
<body>

<header class="header-top">
    <div class="header-logo">
        <img src="https://pusmendik.kemendikdasmen.go.id/an/images/logo-kemdikbud-71x72.png" alt="Logo">
    </div>
    <div class="header-text">
        <b>Application</b>
        <small>Based CAT</small>
    </div>
</header>

<div class="login-wrapper">
    <div class="login-card">
        <h2 class="text-center">Selamat Datang</h2>
        
        <div id="infoMessage" class="mb-3">
            <?php if (isset($message) && $message != ''): ?>
                <div class="alert alert-danger text-center py-2 small"><?= $message; ?></div>
            <?php endif; ?>
        </div>

        <?= form_open("login/proses_siswa", array('id' => 'login')); ?>
            
            <div class="input-group-custom">
                <i class="fas fa-user-circle"></i>
                <input type="text" name="identity" class="form-control" placeholder="Username" required autocomplete="off" autofocus>
            </div>

            <div class="input-group-custom">
                <i class="fas fa-lock"></i>
                <input type="password" name="password" id="password" class="form-control" placeholder="Password" required>
                <i id="toggle-password" class="fas fa-eye" style="cursor:pointer; color:#94a3b8; margin-left: 10px;"></i>
            </div>

            <?php if (isset($jadwal) && !empty($jadwal)): ?>
                <div class="input-group-custom">
                    <i class="fas fa-book"></i>
                    <select name="id_jadwal" id="id_jadwal" class="form-control" required>
                        <option value="" disabled selected>-- Pilih Mata Pelajaran --</option>
                        <?php foreach ($jadwal as $j): ?>
                            <option value="<?= $j->id_ujian ?>"><?= $j->nama_mapel ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            <?php else: ?>
                <div class="alert alert-warning text-center py-2 small mb-3">
                    <i class="fas fa-exclamation-triangle mr-1"></i> Tidak ada jadwal ujian yang aktif saat ini.
                </div>
            <?php endif; ?>

            <button type="submit" id="submit" class="btn btn-login">
                Login
            </button>
        <?= form_close(); ?>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function(){
        
        // 1. Logika Interaktif Lihat/Sembunyikan Password
        $('#toggle-password').on('click', function () {
            const field = $('#password');
            const type = field.attr('type') === 'password' ? 'text' : 'password';
            field.attr('type', type);
            $(this).toggleClass('fa-eye fa-eye-slash');
        });

        // 2. Kirim Data Form via AJAX Async
        $('form#login').on('submit', function(e){
            e.preventDefault(); 
            
            var infobox = $('#infoMessage');
            var btn = $('#submit');
            
            infobox.html('<div class="alert alert-info text-center py-2"><i class="fas fa-spinner fa-spin mr-2"></i>Memeriksa data...</div>');
            btn.attr('disabled', 'disabled').text('Tunggu...');

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                dataType: 'json',
                success: function(res){
                    btn.removeAttr('disabled').text('Login');
                    
                    if(res.status){
                        infobox.html('<div class="alert alert-success text-center py-2">Login Berhasil! Mengalihkan...</div>');
                        localStorage.setItem('garudaCBT.login', '1');
                        window.location.href = '<?= base_url() ?>' + res.url;
                    } else {
                        var msg = res.failed ? res.failed : 'Username atau Password Salah!';
                        infobox.html('<div class="alert alert-danger text-center py-2">' + msg + '</div>');
                    }
                },
                error: function(xhr, status, error) {
                    btn.removeAttr('disabled').text('Login');
                    console.log("Response Error Server:", xhr.responseText);
                    infobox.html('<div class="alert alert-warning text-center py-2">Gagal membaca respon server. Hubungi Proktor/Teknisi.</div>');
                }
            });
        });
    });
</script>

</body>
</html>