        }
        case 'nary': {
            const pr = ommlChild(n, 'naryPr');
            const chrEl = pr && ommlChild(pr, 'chr');
            const chr = chrEl ? (ommlVal(chrEl) || '') : '∫';
            const op = OMML_NARY[chr] || (chr ? ommlTextChar(chr) : '');
            const flag = name => { const e = pr && ommlChild(pr, name); return !!e && ommlVal(e) !== '0' && ommlVal(e) !== 'false'; };
            const sub = flag('subHide') ? '' : ommlKids(ommlChild(n, 'sub')).trim();
            const sup = flag('supHide') ? '' : ommlKids(ommlChild(n, 'sup')).trim();
            return op + (sub ? '_{' + sub + '}' : '') + (sup ? '^{' + sup + '}' : '') + ' ' + ommlGroup(ommlChild(n, 'e'));
        }
        case 'func': {
            const nameEl = ommlChild(n, 'fName');
            const name = nameEl ? nameEl.textContent.trim() : '';
            let fn;
            if (OMML_FUNCS.indexOf(name) >= 0) fn = '\\' + name + ' ';
            else if (OMML_LIMOPS.indexOf(name) >= 0) fn = '\\' + name + ' ';
            else fn = ommlKids(nameEl).trim() || ('\\operatorname{' + name + '}');
            return fn + ' ' + ommlGroup(ommlChild(n, 'e'));
