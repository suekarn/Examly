<script src="<?= base_url() ?>/assets/plugins/jquery/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        // Beri efek berkedip manis pada lampu indikator live score
        $('head').append('<style>@keyframes kdip{0%{opacity:.3}50%{opacity:1}100%{opacity:.3}}#lampu-indikator{animation:kdip 1s infinite}</style>');

        function perbaruiTabelSecaraMurni() {
            var kelasTerpilih  = $('#kelas').val() || "";
            var jadwalTerpilih = $('#jadwal').val() || "";
            var csrfName = $('input[name^="csrf_"]').attr('name');
            var csrfHash = $('input[name^="csrf_"]').val();
            
            var dataKirim = { kelas: kelasTerpilih, jadwal: jadwalTerpilih };
            if(csrfName && csrfHash) { dataKirim[csrfName] = csrfHash; }

            $.ajax({
                url: window.location.href, 
                type: "POST",
                data: dataKirim,
                cache: false,
                success: function(htmlRaw) {
                    var tabelTerbaru = $(htmlRaw).find('#wadah-tabel-live').html();
                    if(tabelTerbaru && tabelTerbaru.trim() !== "") {
                        $('#wadah-tabel-live').html(tabelTerbaru);
                    }
                    var newCsrfHash = $(htmlRaw).find('input[name^="csrf_"]').val();
                    if(newCsrfHash) { $('input[name^="csrf_"]').val(newCsrfHash); }
                }
            });
        }

        // Lakukan sinkronisasi otomatis refresh halaman setiap 5 detik sekali
        setInterval(perbaruiTabelSecaraMurni, 5000);
        // Jalankan refresh instan saat user memilih dropdown kelas/jadwal
        $('#kelas, #jadwal').on('change', function() { perbaruiTabelSecaraMurni(); });
    });
</script>