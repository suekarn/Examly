# ==========================================================
# .gitignore Examly (versi lengkap)
# Semua file dan folder di htdocs ikut dibagikan,
# KECUALI folder assets dan file khusus tiap komputer.
# ==========================================================

# --- Folder yang tidak dibagikan ---
/assets/

/uploads/
/backups/

# --- Opsional: hapus tanda # di bawah jika tidak ingin dibagikan ---
# /key/
/developer-tools/
# /installer/

# --- File dokumentasi yang tidak dibagikan ---
/README.md

# --- Di dalam application/: file khusus tiap komputer (JANGAN dibagikan) ---
/application/config/database.php
/application/config/config.php
/application/config/version.php
/application/updater_data/

# --- Cache dan log (boleh ada folder & index.html, isinya diabaikan) ---
/application/cache/*
!/application/cache/index.html
!/application/cache/.htaccess
/application/logs/*
!/application/logs/index.html
!/application/logs/.htaccess
*/config/development
*/logs/log-*.php

# --- File arsip, cadangan, dan sementara (di mana pun lokasinya) ---
*.zip
*.7z
*.rar
*.apk
*.bak
*.log
*.sql

# --- File editor dan sistem ---
.idea/
*.iml
.vscode/
Thumbs.db
desktop.ini