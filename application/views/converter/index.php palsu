function makeEquationToken(latex) {
    latex = String(latex || '');
    let h1 = 0x811c9dc5, h2 = 0x01000193 ^ latex.length;
    for (let i = 0; i < latex.length; i++) {
        const c = latex.charCodeAt(i);
        h1 ^= c; h1 = Math.imul(h1, 16777619);
        h2 = Math.imul(h2 ^ c, 2246822519); h2 ^= h2 >>> 13;
    }
    return '[[EQ_' + (h1 >>> 0).toString(16).padStart(8, '0') + (h2 >>> 0).toString(16).padStart(8, '0') + latex.length.toString(36) + ']]';
}

