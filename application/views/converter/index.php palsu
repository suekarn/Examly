            const beg = begEl ? (ommlVal(begEl) || '') : '(';
            const end = endEl ? (ommlVal(endEl) || '') : ')';
            const sep = sepEl ? (ommlVal(sepEl) || '') : '|';
            const items = [];
            for (let c = n.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === 'e') items.push(ommlKids(c).trim());
            const sepTex = sep === '' ? '\\ ' : (sep === '|' ? '\\mid ' : ommlDelim(sep));
