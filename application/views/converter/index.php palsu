        body: JSON.stringify({
            model: model,
            messages: [{ role: "user", content: promptText }],
            temperature: 0.1,
            response_format: { type: "json_object" }
        })
    });
    if (!res.ok) await smartApiError(res, "Mistral", model);
    let data = await res.json();
    return data.choices?.[0]?.message?.content;
}

async function callCloudflareApi(accountId, apiToken, model, promptText) {
    let endpoint = `https://api.cloudflare.com/client/v4/accounts/${accountId}/ai/run/${model}`;
    let res = await fetch(endpoint, {
        method: "POST",
        headers: {
