    function waktuHabis() {
        if (waktuHabisBerjalan) return;
        waktuHabisBerjalan = true;
        let tampil = false;
        function gagal() {
            if (!tampil) {
                tampil = true;
                swal.fire({ title: 'Waktu habis', html: 'Menunggu koneksi untuk mengirim jawaban...<br><b>Jangan tutup halaman ini.</b>',
                    icon: 'info', allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false });
            }
            markOffline();
            setTimeout(coba, 4000);
        }
        function coba() {
            flushOutbox().then(function (ok) {
                if (!ok) return gagal();
                const siswa = $('#up').find('input[name="siswa"]').val();
                const bank = $('#up').find('input[name="bank"]').val();
                const jadwal = $('#up').find('input[name="jadwal"]').val();
                $.ajax({
                    url: base_url + 'siswa/savejawaban', method: 'POST', timeout: 15000,
                    data: $('#jawab').serialize() + '&jadwal=' + jadwal + '&siswa=' + siswa + '&bank=' + bank + '&waktu=' + $('#timer').text() + '&elapsed=' + elapsed + '&data=' + JSON.stringify(jsonJawaban),
                    success: function () { $('.konten-soal-jawab').html(''); bersihkanLokal(); dialogWaktu(); },
                    error: gagal
                });
            });
        }
        coba();
    }
    let waktuHabisBerjalan = false;

    function checkAndSaveJawaban() {
        var jwb1 = jawabanSiswa;
        var jwb2 = jawabanBaru;
        if ($.isArray(jwb1)) jwb1 = JSON.stringify(jwb1);
        if (jwb2 != null && $.isArray(jwb2)) jwb2 = JSON.stringify(jwb2);

        if (jawabanBaru != null && jwb1 !== jwb2) {
            clearTimeout(autosaveDebounceTimer);
            // simpan di perangkat dulu, lalu kirim ke server (diulang otomatis kalau koneksi putus)
            simpanJawabanLokal(nomorSoal, jsonJawaban, $('#jawab').serializeArray());
