            var terisi = Array.isArray(a) ? a.length > 0 :
                (a !== null && a !== undefined && String(a).replace(/<[^>]*>/g, '').trim() !== '');
            if (terisi) listStatusSoal[parseInt(d.no_soal_alias || k, 10)] = true;
        });
        localStorage.setItem(storageKey, JSON.stringify(listStatusSoal));
    } catch (e) {}
    let pendingFinish = false;
    try { pendingFinish = !!localStorage.getItem(finKey); } catch (e) {}
    let isOffline = false, retryTimer = null, flushPromise = null, prefetchMulai = false;
    let imgCache = {}, idb = null, pillTimer = null, pernahPeringatan = false;
    let selesaiBerjalan = false, resyncSudah = false, finTimer = null, finBerjalan = false;

    /* ---------- IndexedDB kecil ---------- */
    function idbOpen() {
        return new Promise(function (res) {
            try {
                var r = indexedDB.open('cbt_offline', 1);
                r.onupgradeneeded = function () {
                    var db = r.result;
                    if (!db.objectStoreNames.contains('soal')) db.createObjectStore('soal');
                    if (!db.objectStoreNames.contains('img')) db.createObjectStore('img');
                };
                r.onsuccess = function () { idb = r.result; res(true); };
                r.onerror = function () { res(false); };
            } catch (e) { res(false); }
        });
    }
    function idbGet(store, key) {
        return new Promise(function (res) {
            if (!idb) return res(null);
            try {
                var q = idb.transaction(store).objectStore(store).get(key);
                q.onsuccess = function () { res(q.result || null); };
                q.onerror = function () { res(null); };
            } catch (e) { res(null); }
        });
    }
    function idbSet(store, key, val) {
        return new Promise(function (res) {
            if (!idb) return res(false);
            try {
                var tx = idb.transaction(store, 'readwrite');
                tx.objectStore(store).put(val, key);
                tx.oncomplete = function () { res(true); };
                tx.onerror = function () { res(false); };
            } catch (e) { res(false); }
        });
    }
    function idbEach(store, prefix, fn, hapus) {
        return new Promise(function (res) {
            if (!idb) return res();
            try {
                var tx = idb.transaction(store, hapus ? 'readwrite' : 'readonly');
                var cur = tx.objectStore(store).openCursor();
                cur.onsuccess = function () {
                    var c = cur.result;
                    if (!c) return;
                    if (String(c.key).indexOf(prefix) === 0) {
                        if (fn) fn(c.key, c.value);
                        if (hapus) c.delete();
                    }
                    c.continue();
                };
                tx.oncomplete = function () { res(); };
                tx.onerror = function () { res(); };
            } catch (e) { res(); }
        });
    }
    idbOpen().then(function () {
        idbEach('img', kunciLokal + '|', function (k, v) { imgCache[k.substring(kunciLokal.length + 1)] = v; });
    });

    /* ---------- Util status ---------- */
    function isFilled(v) {
        return v !== '' && v !== null && v !== undefined && (!$.isArray(v) || v.length > 0);
    }
    function hitungTerjawabLokal() {
        let n = 0, total = parseInt(soalTotal) || 0;
        for (let i = 1; i <= total; i++) { if (listStatusSoal[i] === true) n++; }
        return n;
    }
    function daftarKosong() {
        let out = [], total = parseInt(soalTotal) || 0;
        for (let i = 1; i <= total; i++) { if (listStatusSoal[i] !== true) out.push(i); }
        return out;
    }
    function jumlahBelumTerkirim() {
        let n = 0;
        for (const k in answersStore) { if (answersStore[k].s === 0) n++; }
        return n;
    }
    function persistAnswers() {
        try { localStorage.setItem(ansKey, JSON.stringify(answersStore)); } catch (e) {}
    }

    /* ---------- Indikator koneksi ---------- */
    function setNetState() {
        const n = jumlahBelumTerkirim();
        const $p = $('#net-pill');
        clearTimeout(pillTimer);
        if (isOffline || n > 0) {
            pernahPeringatan = true;
            $p.removeClass('d-none ok').addClass('warn').html(
                '<i class="fa ' + (isOffline ? 'fa-plug' : 'fa-sync-alt') + '"></i> ' +
                (isOffline ? 'Internet terputus. Jawaban tersimpan di perangkat dan akan dikirim otomatis saat internet kembali' : 'Mengirim jawaban ke server...') +
                (n > 0 ? ' (' + n + ' menunggu terkirim)' : ''));
        } else if (pernahPeringatan) {
            pernahPeringatan = false;
            $p.removeClass('d-none warn').addClass('ok').html('<i class="fa fa-check-circle"></i> Semua jawaban sudah tersimpan di server');
            pillTimer = setTimeout(function () { $p.addClass('d-none'); }, 3500);
        } else {
            $p.addClass('d-none');
        }
    }
    function markOffline() { isOffline = true; setNetState(); scheduleRetry(); }
    function markOnline() { if (isOffline) { isOffline = false; } setNetState(); }
    function scheduleRetry() {
        if (retryTimer) return;
        retryTimer = setInterval(function () {
            if (!isOffline && jumlahBelumTerkirim() === 0) { clearInterval(retryTimer); retryTimer = null; return; }
            if (jumlahBelumTerkirim() > 0) flushOutbox(); else pingServer();
        }, 5000);
    }
    function pingServer() {
        $.ajax({ url: base_url, type: 'HEAD', cache: false, timeout: 5000,
            complete: function (xhr) { if (xhr && xhr.status > 0) markOnline(); } });
    }
    window.addEventListener('online', function () {
        // Status 'online' browser belum menjamin internet/server tersedia.
        if (jumlahBelumTerkirim() > 0) flushOutbox();
        else pingServer();
    });
    window.addEventListener('offline', function () { markOffline(); });
    // Pulihkan antrean setelah halaman dibuka ulang. Polling membantu jaringan yang
    // tersambung ke Wi-Fi tetapi internet/server belum dapat dijangkau.
    if (!navigator.onLine) markOffline();
    else if (jumlahBelumTerkirim() > 0) scheduleRetry();

    window.addEventListener('beforeunload', function (e) {
        if (jumlahBelumTerkirim() > 0 || pendingFinish) { e.preventDefault(); e.returnValue = ''; }
    });

    /* ---------- Antrean jawaban ---------- */
    function simpanJawabanLokal(nomor, d, formFields) {
        answersStore[nomor] = {
            d: $.extend(true, {}, d),
            f: formFields,
            siswa: $('#up').find('input[name="siswa"]').val(),
            bank: $('#up').find('input[name="bank"]').val(),
            t: Date.now(),
            s: 0
        };
        persistAnswers();
        setNetState();
    }
    function csrfTerbaru() {
        const o = {};
        $('#jawab input[type="hidden"]').not('[name="siswa"],[name="jadwal"],[name="bank"]').each(function () { o[this.name] = this.value; });
        return o;
    }
    function buildFormData(entry) {
        const fd = new FormData();
        const csrf = csrfTerbaru();
        (entry.f || []).forEach(function (x) {
            fd.append(x.name, Object.prototype.hasOwnProperty.call(csrf, x.name) ? csrf[x.name] : x.value);
        });
        fd.append('siswa', entry.siswa);
        fd.append('bank', entry.bank);
        const jns = entry.d['jenis'];
        for (const key in entry.d) {
            if ((jns === '2' || jns === '3') && key === 'jawaban_siswa') {
                fd.append('data[' + key + ']', JSON.stringify(entry.d[key]));
            } else {
                fd.append('data[' + key + ']', entry.d[key]);
            }
        }
        return fd;
    }
    function flushOutbox() {
        if (flushPromise) return flushPromise;
        flushPromise = new Promise(function (resolve) {
            (function loop() {
                const keys = Object.keys(answersStore).filter(function (k) { return answersStore[k].s === 0; });
                if (!keys.length) { flushPromise = null; if (navigator.onLine) markOnline(); setNetState(); return resolve(true); }
                const nomor = keys[0];
                const entry = answersStore[nomor];
                const ver = entry.t;
                $.ajax({
                    url: base_url + 'siswa/savejawaban', method: 'POST', processData: false, contentType: false,
                    data: buildFormData(entry), timeout: 15000
                }).done(function (response) {
                    if (response && response.soal_terjawab !== undefined) {
                        soalTerjawab = parseInt(response.soal_terjawab) || 0;
                        perbaruiProgressBar();
                    }
                    if (answersStore[nomor] && answersStore[nomor].t === ver) answersStore[nomor].s = 1;
                    persistAnswers();
                    isOffline = false;
                    loop();
                }).fail(function () {
                    flushPromise = null;
                    markOffline();
                    resolve(false);
                });
            })();
        });
        return flushPromise;
    }

    /* ---------- Cache soal & gambar ---------- */
    function kumpulkanGambar(data) {
        const out = [];
        const s = JSON.stringify(data);
        const re = /<img[^>]*?src=\\?["']([^"'\\]+)["']/gi;
        let m;
        while ((m = re.exec(s)) !== null) {
            if (m[1].indexOf('uploads') === -1) continue;
            const u = absGambar(m[1]);
            if (u && out.indexOf(u) === -1) out.push(u);
        }
        return out;
    }
    function absGambar(src) {
        if (!src || src.indexOf('data:') === 0) return null;
        if (src.indexOf('http') === -1) return base_url + src;
        if (src.indexOf(base_url) === -1) {
            const p = src.split('uploads');
            return p.length > 1 ? base_url + 'uploads' + p[1] : src;
        }
        return src;
    }
    function prefetchGambar(url) {
        if (imgCache[url] || !window.fetch || !window.FileReader) return;
        fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.blob() : null; }).then(function (b) {
            if (!b || b.size > 2500000) return;
            const fr = new FileReader();
            fr.onload = function () {
                imgCache[url] = fr.result;
                idbSet('img', kunciLokal + '|' + url, fr.result);
            };
            fr.readAsDataURL(b);
        }).catch(function () {});
    }
    function attachImgFallback(el) {
        $(el).on('error', function () {
            const d = imgCache[this.src];
            if (d && this.src !== d) this.src = d;
        });
    }
    function simpanCache(nomor, data) {
        idbSet('soal', kunciLokal + ':' + nomor, data);
        if (listStatusSoal[nomor] === undefined && String(data.soal_jenis) !== '3') {
            listStatusSoal[nomor] = isFilled(data.soal_jawaban_siswa);
        }
        kumpulkanGambar(data).forEach(prefetchGambar);
    }
    function getCache(nomor) { return idbGet('soal', kunciLokal + ':' + nomor); }

    function prefetchSemuaSoal() {
        if (prefetchMulai || !idb) return;
        prefetchMulai = true;
        let n = 1;
        (function next() {
            const total = parseInt(soalTotal) || 0;
            if (n > total) {
                // kembalikan posisi soal di server ke soal yang sedang dibuka siswa
                $.ajax({ type: 'POST', url: base_url + 'siswa/loadnomorsoal', timeout: 15000,
                    data: $('#up').serialize() + '&nomor=' + nomorSoal + '&timer=' + $('#timer').text() + '&elapsed=' + elapsed });
                return;
            }
            const nomor = n++;
            getCache(nomor).then(function (c) {
                if (c) return next();
                $.ajax({ type: 'POST', url: base_url + 'siswa/loadnomorsoal', timeout: 20000,
                    data: $('#up').serialize() + '&nomor=' + nomor + '&timer=' + $('#timer').text() + '&elapsed=' + elapsed
                }).done(function (d) {
                    if (d && d.soal_id) simpanCache(nomor, d);
                }).always(function () { setTimeout(next, 150); });
            });
        })();
    }

    function terapkanLokal(data, dariCache) {
        data = $.extend(true, {}, data);
        const e = answersStore[data.soal_nomor];
        if (e && e.d && e.d.jawaban_siswa !== undefined && String(data.soal_jenis) !== '3' && (dariCache || e.s === 0)) {
            data.soal_jawaban_siswa = e.d.jawaban_siswa;
        }
        if (dariCache) {
            data.durasi = $.extend({}, data.durasi, { lama_ujian: elapsed });
            if (soalTotal) data.soal_total = soalTotal;
            data.soal_terjawab = hitungTerjawabLokal();
        }
        return data;
    }

    function bersihkanLokal() {
        try { localStorage.removeItem(storageKey); localStorage.removeItem(ansKey); localStorage.removeItem(finKey); } catch (e) {}
        pendingFinish = false;
        answersStore = {};
        idbEach('soal', kunciLokal + ':', null, true);
        idbEach('img', kunciLokal + '|', null, true);
    }

    /* ---------- Cek kelengkapan jawaban sebelum selesai ---------- */
    function hasilLokal(dariServerGagal) {
        const total = parseInt(soalTotal) || 0, ter = hitungTerjawabLokal();
        return { sumber: 'lokal', total: total, terjawab: ter, lengkap: total > 0 && ter >= total, kosong: daftarKosong() };
    }
    function cekKelengkapan() {
        return flushOutbox().then(function (ok) {
            if (!ok) return hasilLokal(true);
            return new Promise(function (res) {
                $.ajax({ type: 'POST', url: base_url + 'siswa/loadnomorsoal', dataType: 'json', timeout: 15000,
                    data: $('#up').serialize() + '&nomor=' + (nomorSoal || 1) + '&timer=' + $('#timer').text() + '&elapsed=' + elapsed
                }).done(function (d) {
                    const total = parseInt(d.soal_total) || parseInt(soalTotal) || 0;
                    const ter = (d.soal_terjawab === undefined || d.soal_terjawab === null) ? hitungTerjawabLokal() : (parseInt(d.soal_terjawab) || 0);
                    soalTotal = total; soalTerjawab = ter; perbaruiProgressBar();
                    const hasil = { sumber: 'server', total: total, terjawab: ter, lengkap: total > 0 && ter >= total, kosong: daftarKosong() };
                    const lokalTerjawab = hitungTerjawabLokal();
                    // Jika server mencatat lebih sedikit daripada jawaban lokal, kirim ulang
                    // antrean lokal sekali lagi sebelum menyatakan ujian belum selesai.
                    if (total > 0 && ter < lokalTerjawab && !resyncSudah) {
                        resyncSudah = true;
                        for (const k in answersStore) {
                            if (answersStore[k] && answersStore[k].d) answersStore[k].s = 0;
                        }
                        persistAnswers();
                        return cekKelengkapan().then(res);
                    }
                    res(hasil);
                }).fail(function () { res(hasilLokal(true)); });
            });
        });
    }

    /* ---------- Selesai & waktu habis ---------- */
    function kirimSelesai() {
        return flushOutbox().then(function (ok) {
            if (!ok) return { ok: false };
            return new Promise(function (res) {
                $.ajax({ url: base_url + 'siswa/selesaiujian', method: 'POST', data: $('#up').serialize(), timeout: 20000 })
                    .done(function (r) { res({ ok: true, r: r }); })
                    .fail(function () { res({ ok: false }); });
            });
        });
    }
    function tungguSelesai() {
        try { localStorage.setItem(finKey, '1'); } catch (e) {}
        pendingFinish = true;
        swal.fire({
            title: 'Menunggu koneksi',
            html: 'Jawaban Anda sudah tersimpan di perangkat dan akan dikirim otomatis saat koneksi kembali.<br><b>Jangan tutup atau muat ulang halaman ini.</b>',
            icon: 'info', allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false
        });
        if (finTimer) return;
        function coba() {
            if (finBerjalan) return;
            finBerjalan = true;
            kirimSelesai().then(function (h) {
