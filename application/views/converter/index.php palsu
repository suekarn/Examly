        case 'limLow': {
            const eEl = ommlChild(n, 'e'), name = eEl ? eEl.textContent.trim() : '';
            const lim = ommlKids(ommlChild(n, 'lim')).trim();
            if (OMML_LIMOPS.indexOf(name) >= 0) return '\\' + name + '_{' + lim + '} ';
            return '\\underset{' + lim + '}' + ommlGroup(eEl);
