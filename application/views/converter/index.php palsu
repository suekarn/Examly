async function handleFileUpload(input) {
    const file = input.files[0];
    if (!file) return;

    const ext = file.name.split('.').pop().toLowerCase();
    const container = document.getElementById('inputText');

    showProgressState("Mengekstrak Dokumen " + ext.toUpperCase() + "...");
    container.innerHTML = "Sedang mengekstrak berkas, mohon tunggu...";
    isAiProcessed = false;

    let reader = new FileReader();

    if (ext === 'docx') {
        if (typeof mammoth === 'undefined') {
            alert("Library Mammoth.js belum siap.");
            container.innerHTML = "";
            renderPreview();
            return;
        }

        reader.onload = async function(e) {
            try {
                // Equation Word (OMML) dijadikan token [[EQ_xxxx]] dulu karena Mammoth membuangnya.
                EDITOR_EQUATIONS = {};
                const docxBuffer = await preprocessDocxForImport(e.target.result);
                let result = await mammoth.convertToHtml({ arrayBuffer: docxBuffer });
                if (result.value && result.value.trim() !== "") {
                    let tempDiv = document.createElement('div');
                    tempDiv.innerHTML = result.value;

                    // Ubah numbering Word (OL/LI) menjadi nomor/HURUF MANUAL.
                    // Top-level list = nomor soal, nested list = opsi A-E.
                    normalizeImportedDocxLists(tempDiv);

                    // Token rumus -> tampil sebagai rumus (bukan teks [[EQ_...]]) di kolom Input.
                    equationTokensToEditorSpans(tempDiv);

                    // Jangan diratakan menjadi innerText. HTML ini dimasukkan ke editor
                    // supaya tabel dan nomor manual tetap terlihat di Input Bank Soal Mentah.
                    container.innerHTML = tempDiv.innerHTML.trim();

                    parsedData = [];
                    parseEditorContent();
                    scheduleCacheLookup();
                } else {
                    alert("Teks dokumen kosong atau tidak terbaca.");
                    container.innerHTML = "";
                    renderPreview();
                }
            } catch (err) {
                alert("Gagal membaca berkas Word: " + err.message);
                container.innerHTML = "";
                renderPreview();
            }
        };
        reader.readAsArrayBuffer(file);

    } else if (ext === 'pdf') {
        if (typeof pdfjsLib === 'undefined') {
            alert("Library PDF.js belum siap.");
            container.innerHTML = "";
            renderPreview();
            return;
        }

        reader.onload = function(e) {
            let typedarray = new Uint8Array(e.target.result);
            pdfjsLib.getDocument({ data: typedarray }).promise.then(async function(pdf) {
                let maxPages = pdf.numPages;
                let fullText = "";

                for (let j = 1; j <= maxPages; j++) {
                    try {
                        showProgressState(`Mengekstrak PDF (Halaman ${j} dari ${maxPages})...`);
                        let page = await pdf.getPage(j);
                        let tokenizedText = await page.getTextContent();
                        let pageText = "";
                        let lastY = null;

                        for (let item of tokenizedText.items) {
                            if (lastY !== null && Math.abs(item.transform[5] - lastY) > 5) {
                                pageText += "\n";
                            }
                            pageText += item.str + " ";
                            lastY = item.transform[5];
                        }
                        fullText += pageText + "\n\n";
                    } catch (pageErr) {
                        console.warn(pageErr);
                    }
                }

                if (fullText.trim() !== "") {
                    container.innerText = fullText.trim();
                    parsedData = [];
                    parseLocalInstantly(fullText);
                    scheduleCacheLookup();
                } else {
                    alert("PDF tidak memiliki layer teks.");
                    container.innerHTML = "";
                    renderPreview();
                }
            }).catch(err => {
                alert("Gagal membaca PDF: " + err.message);
                container.innerHTML = "";
                renderPreview();
            });
        };
        reader.readAsArrayBuffer(file);
    }
    input.value = '';
}

function normalizeImportedDocxLists(root) {
    const lists = Array.from(root.querySelectorAll('ol, ul')).filter(list => !list.parentElement.closest('ol, ul'));
    let questionNo = 1;

    function makeManualList(list, level) {
        const fragment = document.createDocumentFragment();
        const items = Array.from(list.children).filter(el => el.tagName === 'LI');

        items.forEach((li, index) => {
            const wrapper = document.createElement('div');
            wrapper.className = level === 0 ? 'import-question-line' : 'import-option-line';

            const prefix = level === 0
                ? (questionNo++) + '. '
                : String.fromCharCode(65 + Math.min(index, 25)) + '. ';

            const nestedLists = Array.from(li.children).filter(el => /^(OL|UL)$/i.test(el.tagName));
            const content = document.createElement('span');
            Array.from(li.childNodes).forEach(node => {
                if (node.nodeType === 1 && /^(OL|UL)$/i.test(node.tagName)) return;
                content.appendChild(node.cloneNode(true));
            });
            wrapper.appendChild(document.createTextNode(prefix));
            wrapper.appendChild(content);
            fragment.appendChild(wrapper);

            nestedLists.forEach(nested => {
                fragment.appendChild(makeManualList(nested, level + 1));
            });
        });
        return fragment;
    }

    lists.forEach(list => {
        const fragment = makeManualList(list, 0);
        list.parentNode.replaceChild(fragment, list);
    });
}

