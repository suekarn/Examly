<script type="text/javascript" src="<?= base_url() ?>/assets/app/js/tableToExcel.js"></script>

<script>
    var colWidthMin = '5,15,35,15,10,10,10,10,10,10';
    var colWidth = '<?= $colWidth ?>';

    var idJadwal = '<?=$jadwal_selected?>';
    var idKelas = '<?=$kelas_selected?>';
    const arrSiswa = <?= json_encode($siswas) ?>;
    var isSelected = <?= count($siswas) > 0 ? 1 : 0?>;
    var namaMapel = '<?=isset($info) ? $info->kode : ''?>';
    var jenisUjian = '<?=isset($info) ? $info->kode_jenis : ''?>';

    var nilai_max = <?=$XA?>;
    var nilai_min = <?=$XB?>;
    var hasil_max = <?=$YA?>;
    var hasil_min = <?=$YB?>;

    function lihatJawaban(idSiswa) {
        window.location.href = base_url + 'cbtnilai/detail?siswa=' + idSiswa + '&jadwal=' + idJadwal;
    }

    function getKelasJadwal(idKelas) {
        $.ajax({
            type: "GET",
            url: base_url + "cbtstatus/getjadwalujianbykelas?id_kelas=" + idKelas,
            cache: false,
            success: function (response) {
                var selJadwal = $('#jadwal');
                selJadwal.html('');
                selJadwal.append('<option value="">Pilih Jadwal</option>');
                $.each(response, function (k, v) {
                    if (v != null) {
                        selJadwal.append('<option value="' + k + '">' + v + '</option>');
                    }
                });
                const enb = isSelected && $("#jadwal").val() === "<?= $jadwal_selected ?>"
                $('#import-essai').attr('disabled', !enb).toggleClass('btn-disabled', !enb);
            }
        });
    }

    $(document).ready(function () {
        ajaxcsrf();

        const loading = $('#loading');
        var opsiJadwal = $("#jadwal");
        var opsiKelas = $("#kelas");

        var selected = isSelected === 0 ? "selected='selected'" : "";
        opsiJadwal.prepend("<option value='' " + selected + " disabled>Pilih Jadwal</option>");
        opsiKelas.prepend("<option value='' " + selected + " disabled>Pilih Kelas</option>");
        $('#import-essai').attr('disabled', !isSelected).toggleClass('btn-disabled', !isSelected);
        $('#mark-all').attr('disabled', !isSelected).toggleClass('btn-disabled', !isSelected);

        // --- CORE LIVE SCORE REALTIME ENGINE ---
        // Menjalankan background worker setiap 5 detik jika kelas & jadwal dipilih
        setInterval(function() {
            if (opsiKelas.val() && opsiJadwal.val()) {
                $.ajax({
                    type: "GET",
                    url: window.location.href,
                    cache: false,
                    dataType: "html",
                    success: function(data) {
                        var freshHtml = $(data);
                        
                        var currentContainer = $('#live-container');
                        var freshContainerContent = freshHtml.find('#live-container').html();
                        
                        // Deteksi jumlah baris tabel (Jumlah siswa yang ikut ujian)
                        var currentRows = currentContainer.find('#live-table-body tr').length;
                        var freshRows = freshHtml.find('#live-table-body tr').length;

                        // JIKA STATUS BERUBAH (Dari tidak ada ujian menjadi ada ujian / sebaliknya)
                        if (currentRows !== freshRows || currentRows === 0 || freshRows === 0) {
                            // Ganti seluruh container, otomatis memunculkan/menyembunyikan tabel secara instan
                            currentContainer.html(freshContainerContent);
                            
                            // Update badge header 'LIVE RUNNING'
                            $('#live-header-badge').html(freshHtml.find('#live-header-badge').html());
                            
                            // Atur status tombol aksi
                            var hasData = freshRows > 0;
                            $('#import-essai, #mark-all').attr('disabled', !hasData).toggleClass('btn-disabled', !hasData);
                        } else {
                            // JIKA HANYA UPDATE NILAI (Live update berjalan sel per sel agar tidak berkedip)
                            currentContainer.find('#live-table-body tr').each(function() {
                                var rowId = $(this).attr('id');
                                if (rowId) {
                                    var targetRow = freshHtml.find('#' + rowId);
                                    if (targetRow.length) {
                                        var selectors = [
                                            '.cell-mulai', '.cell-durasi', '.cell-benar', 
                                            '.cell-salah', '.cell-skor-pg', '.cell-skor-kompleks', 
                                            '.cell-skor-jodohkan', '.cell-skor-isian', '.cell-skor-essai', 
                                            '.cell-skor-total', '.cell-skor-katrol', '.status-koreksi-icon'
                                        ];

                                        selectors.forEach(function(selector) {
                                            var currentElem = $('#' + rowId + ' ' + selector);
                                            var freshContent = targetRow.find(selector).html();
                                            
                                            if (currentElem.html() !== freshContent) {
                                                if(selector.includes('cell-skor') || selector.includes('cell-benar')) {
                                                    // Efek highlight stabilizer kuning saat nilai berubah realtime
                                                    currentElem.html(freshContent).css('background-color', '#fff9db');
                                                    setTimeout(function() {
                                                        currentElem.css('background-color', '');
                                                    }, 1000);
                                                } else {
                                                    currentElem.html(freshContent);
                                                }
                                            }
                                        });

                                        var btnKoreksi = $('#' + rowId + ' .action-koreksi');
                                        var targetBtn = targetRow.find('.action-koreksi');
                                        if (targetBtn.length && !targetBtn.prop('disabled') && btnKoreksi.prop('disabled')) {
                                            btnKoreksi.removeAttr('disabled').removeClass('disabled');
                                        }
                                    }
                                }
                            });
                        }
                    }
                });
            }
        }, 5000); // interval refresh 5 detik

        function loadSiswaKelas(kelas, jadwal) {
            if (jadwal !== null) {
                loading.removeClass('d-none');
                window.location.href = base_url + 'cbtnilai?kelas=' + kelas + '&jadwal=' + jadwal;
            }
        }

        // Event Delegation binding untuk komponen di dalam container AJAX agar tombol tidak macet
        $(document).on('click', '#download-excel', function () {
            var table = document.querySelector("#table-status");
            if (table != null) {
                TableToExcel.convert(table, {
                    name: `Nilai ${jenisUjian} ${$("#kelas option:selected").text()} ${namaMapel}.xlsx`,
                    sheet: { name: "Sheet 1" }
                });
            } else {
                Swal.fire({ title: "ERROR", text: "Isi JADWAL dan KELAS terlebih dulu", icon: "error" });
            }
        });

        $(document).on('change', '#nilai-detail', function () {
            var exluded = this.checked;
            $('#no-soal-tile').attr('data-exclude', '' + !exluded);
            $('.no-soal').attr('data-exclude', '' + !exluded);
            $('.no-soal-siswa').attr('data-exclude', '' + !exluded);
            var width = $('#table-status').attr('data-cols-width');
            $('#table-status').attr('data-cols-width', width == colWidth ? colWidthMin : colWidth)
        });

        $(document).on('click', '#rollback', function () {
            loadSiswaKelas(opsiKelas.val(), opsiJadwal.val())
        });

        opsiKelas.change(function () {
            getKelasJadwal($(this).val());
        });

        opsiJadwal.change(function () {
            loadSiswaKelas(opsiKelas.val(), $(this).val())
        });

        $('#perbaikan-nilai').on('submit', function (e) {
            e.preventDefault();
            if (document.querySelector("#table-status") != null) {
                var values = {};
                $('#perbaikan-nilai :input').each(function () { values[this.name] = $(this).val(); });
                hasil_max = values['ya'];
                hasil_min = values['yb'];
                $('#perbaikanModal').modal('hide');
                loading.removeClass('d-none');
                window.location.href = base_url + 'cbtnilai?kelas=' + opsiKelas.val() + '&jadwal=' + opsiJadwal.val() +
                    '&xa=' + nilai_max + '&xb=' + nilai_min + '&ya=' + hasil_max + '&yb=' + hasil_min;
            } else {
                $('#perbaikanModal').modal('hide');
                Swal.fire({ title: "ERROR", text: "Isi JADWAL dan KELAS terlebih dulu", icon: "error" });
            }
        });

        $("#import-essai").on("click", function () {
            if (opsiKelas.val() != null && opsiJadwal.val() != null) {
                window.location.href = base_url + 'cbtnilai/inputessai?kelas=' + opsiKelas.val() + '&jadwal=' + opsiJadwal.val();
            }
        });

        $('#mark-all').on('click', function () {
            let dataPost = new FormData($('#koreksi-semua')[0]);
            dataPost.append('id_jadwal', idJadwal);
            loading.removeClass('d-none');
            swal.fire({
                text: "Silahkan tunggu....",
                button: false,
                allowOutsideClick: false,
                onOpen: () => { swal.showLoading(); }
            });
            $.ajax({
                url: base_url + "cbtnilai/tandaisemua",
                type: "POST",
                data: dataPost,
                processData: false,
                contentType: false,
                success: function (data) {
                    if (data.success > 0) {
                        swal.fire({ title: "Berhasil", text: "Koreksi nilai berhasil disimpan", icon: "success" }).then(result => {
                            if (result.value) { window.location.reload(); }
                        });
                    } else {
                        loading.addClass('d-none');
                        swal.fire({ title: "Gagal", text: 'Tidak ada nilai yang disimpan', icon: "error" });
                    }
                }, error: function (xhr) {
                    loading.addClass('d-none');
                    const err = JSON.parse(xhr.responseText);
                    swal.fire({ title: "Error", text: err.Message, icon: "error" });
                }
            });
        });

        opsiKelas.select2({theme: 'bootstrap4'});
        opsiJadwal.select2({theme: 'bootstrap4'});
    });
</script>