        case 'bar': {
            const pr = ommlChild(n, 'barPr');
            const posEl = pr && ommlChild(pr, 'pos');
            const pos = posEl ? ommlVal(posEl) : 'bot';
            return (pos === 'top' ? '\\overline' : '\\underline') + ommlGroup(ommlChild(n, 'e'));
        }
        case 'groupChr': {
            const pr = ommlChild(n, 'groupChrPr');
            const chrEl = pr && ommlChild(pr, 'chr'), posEl = pr && ommlChild(pr, 'pos');
            const chr = chrEl ? ommlVal(chrEl) : '⏟';
            const pos = posEl ? ommlVal(posEl) : (chr === '⏞' ? 'top' : 'bot');
            return (pos === 'top' ? '\\overbrace' : '\\underbrace') + ommlGroup(ommlChild(n, 'e'));
        }
        case 'borderBox': return '\\boxed' + ommlGroup(ommlChild(n, 'e'));
        case 'eqArr': {
            const rows = [];
            for (let c = n.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === 'e') rows.push(ommlKids(c).trim());
            return '\\begin{aligned}' + rows.join(' \\\\ ') + '\\end{aligned}';
        }
        case 'm': {
            const rows = [];
            for (let r = n.firstChild; r; r = r.nextSibling) {
                if (r.nodeType !== 1 || r.localName !== 'mr') continue;
                const cells = [];
                for (let c = r.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === 'e') cells.push(ommlKids(c).trim());
                rows.push(cells.join(' & '));
            }
            return '\\begin{matrix}' + rows.join(' \\\\ ') + '\\end{matrix}';
        }
        default: return ommlKids(n);
    }
}
function ommlToLatex(oMathEl) {
    let s = '';
    try { s = ommlKids(oMathEl); } catch (e) { console.warn('OMML->LaTeX gagal:', e); }
    return s.replace(/[ \t\r\n]+/g, ' ').trim();
}
// OMML ringkas (tanpa properti font Word) untuk ditanam kembali ke file .docx hasil unduhan.
function ommlForExport(oMathEl) {
    const c = oMathEl.cloneNode(true);
    Array.from(c.getElementsByTagNameNS(EQ_NS_W, 'rPr')).forEach(e => e.parentNode && e.parentNode.removeChild(e));
    let s = new XMLSerializer().serializeToString(c);
    if (!/xmlns:m=/.test(s)) s = s.replace(/^<m:oMath/, '<m:oMath xmlns:m="' + EQ_NS_M + '"');
    return s;
}

function renderEquationHtml(latex) {
    try {
        if (window.katex && typeof window.katex.renderToString === 'function') {
            return window.katex.renderToString(String(latex || ''), { throwOnError: false, displayMode: false, output: 'html', strict: 'ignore' });
        }
    } catch (e) { console.warn('KaTeX gagal:', e); }
    return '<span class="eq-fallback">' + escapeHtml(String(latex || '')) + '</span>';
}

function makeEquationSpan(token) {
    const eq = EDITOR_EQUATIONS[token];
    if (!eq) return document.createTextNode(token);
    const span = document.createElement('span');
    span.className = 'eq-token';
    span.setAttribute('contenteditable', 'false');
    span.setAttribute('data-eq', token);
    span.setAttribute('data-latex', eq.latex);
    if (eq.omml) span.setAttribute('data-omml', eq.omml);
    span.innerHTML = renderEquationHtml(eq.latex);
    return span;
}

// Token [[EQ_xxxx]] di dalam teks -> elemen rumus (dipakai di kolom Input Bank Soal Mentah).
function equationTokensToEditorSpans(root) {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(node => {
        const txt = node.nodeValue || '';
        const re = /\[\[EQ_[0-9a-z]+\]\]/g;
        if (!re.test(txt)) return;
        re.lastIndex = 0;
        const frag = document.createDocumentFragment();
        let last = 0, m;
        while ((m = re.exec(txt)) !== null) {
            if (m.index > last) frag.appendChild(document.createTextNode(txt.slice(last, m.index)));
            frag.appendChild(makeEquationSpan(m[0]));
            last = m.index + m[0].length;
        }
        if (last < txt.length) frag.appendChild(document.createTextNode(txt.slice(last)));
        node.parentNode.replaceChild(frag, node);
    });
}

function docxFirstChildNS(el, name) {
    if (!el) return null;
    for (let c = el.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c.localName === name && c.namespaceURI === EQ_NS_W) return c;
    return null;
}
function docxWVal(el) {
    if (!el) return null;
    let v = el.getAttributeNS(EQ_NS_W, 'val');
    if (v === null || v === '') v = el.getAttribute('w:val');
    return v;
}

// Ganti setiap <m:oMath> / <m:oMathPara> dengan run teks berisi token [[EQ_xxxx]].
function convertDocxEquations(doc) {
    let changed = false;
    const makeRun = omath => {
        const latex = ommlToLatex(omath);
        if (!latex) return null;
        const token = makeEquationToken(latex);
        EDITOR_EQUATIONS[token] = { latex: latex, omml: ommlForExport(omath) };
        const r = doc.createElementNS(EQ_NS_W, 'w:r');
        const t = doc.createElementNS(EQ_NS_W, 'w:t');
        t.setAttributeNS('http://www.w3.org/XML/1998/namespace', 'xml:space', 'preserve');
        t.textContent = token;
        r.appendChild(t);
        return r;
    };
    Array.from(doc.getElementsByTagNameNS(EQ_NS_M, 'oMathPara')).forEach(para => {
        const parent = para.parentNode;
        if (!parent) return;
        Array.from(para.childNodes).filter(n => n.nodeType === 1 && n.localName === 'oMath').forEach(om => {
            const run = makeRun(om);
            if (run) parent.insertBefore(run, para);
        });
        parent.removeChild(para);
        changed = true;
    });
    Array.from(doc.getElementsByTagNameNS(EQ_NS_M, 'oMath')).forEach(om => {
        const parent = om.parentNode;
        if (!parent) return;
        const run = makeRun(om);
        if (run) parent.replaceChild(run, om); else parent.removeChild(om);
        changed = true;
    });
    return changed;
}

// Daftar huruf Word (a. b. c. d.) pada level paling atas biasanya dipakai sebagai OPSI jawaban,
// tetapi Mammoth menganggapnya daftar bernomor baru sehingga nomor soal jadi kacau.
// Ubah menjadi teks biasa "a. isi" agar dibaca sebagai opsi (nesting daftar lain tidak diubah).
function flattenLetterLists(doc, numDoc) {
    if (!numDoc) return false;
    const numToAbs = {}, startOverride = {}, absLvl = {};
    Array.from(numDoc.getElementsByTagNameNS(EQ_NS_W, 'abstractNum')).forEach(a => {
        const id = a.getAttributeNS(EQ_NS_W, 'abstractNumId');
        absLvl[id] = {};
        Array.from(a.childNodes).forEach(l => {
            if (l.nodeType !== 1 || l.localName !== 'lvl') return;
            const il = l.getAttributeNS(EQ_NS_W, 'ilvl');
            const fmt = docxWVal(docxFirstChildNS(l, 'numFmt'));
            const st = docxWVal(docxFirstChildNS(l, 'start'));
            absLvl[id][il] = { fmt: fmt, start: st === null ? 1 : (parseInt(st, 10) || 1) };
        });
    });
    Array.from(numDoc.getElementsByTagNameNS(EQ_NS_W, 'num')).forEach(nm => {
        const id = nm.getAttributeNS(EQ_NS_W, 'numId');
        numToAbs[id] = docxWVal(docxFirstChildNS(nm, 'abstractNumId'));
        Array.from(nm.childNodes).forEach(o => {
            if (o.nodeType !== 1 || o.localName !== 'lvlOverride') return;
            const so = docxFirstChildNS(o, 'startOverride');
            if (so) startOverride[id + ':' + o.getAttributeNS(EQ_NS_W, 'ilvl')] = parseInt(docxWVal(so), 10) || 1;
        });
    });

    let changed = false;
    let counters = {};
    Array.from(doc.getElementsByTagNameNS(EQ_NS_W, 'p')).forEach(p => {
        const ppr = docxFirstChildNS(p, 'pPr');
        const numPr = docxFirstChildNS(ppr, 'numPr');
        if (!numPr) return;
        const ilvl = parseInt(docxWVal(docxFirstChildNS(numPr, 'ilvl')) || '0', 10) || 0;
        const numId = docxWVal(docxFirstChildNS(numPr, 'numId'));
        if (!numId || numId === '0' || ilvl !== 0) return;
        const lvl = (absLvl[numToAbs[numId]] || {})['0'];
        if (!lvl) return;
        if (!/^(lower|upper)Letter$/.test(lvl.fmt || '')) { counters = {}; return; }   // nomor soal -> reset huruf

        const hasContent = Array.from(p.getElementsByTagNameNS(EQ_NS_W, 't')).some(t => (t.textContent || '').trim()) ||
            p.getElementsByTagNameNS(EQ_NS_W, 'drawing').length > 0 || p.getElementsByTagNameNS(EQ_NS_W, 'pict').length > 0;
        if (!hasContent) return;     // baris kosong (spasi) tidak dihitung sebagai opsi

        const start = startOverride[numId + ':0'] || lvl.start || 1;
        const idx = (counters[numId] === undefined ? start - 1 : counters[numId]) + 1;
        counters[numId] = idx;
        const base = lvl.fmt === 'upperLetter' ? 65 : 97;
        const label = String.fromCharCode(base + ((idx - 1) % 26)) + '. ';

        ppr.removeChild(numPr);
        const r = doc.createElementNS(EQ_NS_W, 'w:r');
        const t = doc.createElementNS(EQ_NS_W, 'w:t');
        t.setAttributeNS('http://www.w3.org/XML/1998/namespace', 'xml:space', 'preserve');
        t.textContent = label;
        r.appendChild(t);
        p.insertBefore(r, ppr.nextSibling);
        changed = true;
    });
    return changed;
}

// Dipanggil sebelum Mammoth: equation -> token, daftar huruf level atas -> teks biasa.
async function preprocessDocxForImport(arrayBuffer) {
    if (typeof JSZip === 'undefined' || typeof DOMParser === 'undefined') return arrayBuffer;
    try {
        const zip = await JSZip.loadAsync(arrayBuffer);
        const docFile = zip.file('word/document.xml');
        if (!docFile) return arrayBuffer;
        const parser = new DOMParser();
        const doc = parser.parseFromString(await docFile.async('string'), 'application/xml');
        if (doc.getElementsByTagName('parsererror').length) return arrayBuffer;

        let changed = convertDocxEquations(doc);
        const numFile = zip.file('word/numbering.xml');
        if (numFile) {
            const numDoc = parser.parseFromString(await numFile.async('string'), 'application/xml');
            if (!numDoc.getElementsByTagName('parsererror').length) changed = flattenLetterLists(doc, numDoc) || changed;
        }
        if (!changed) return arrayBuffer;
        zip.file('word/document.xml', new XMLSerializer().serializeToString(doc));
        return await zip.generateAsync({ type: 'arraybuffer' });
    } catch (err) {
        console.warn('Pra-proses DOCX (equation) dilewati:', err);
        return arrayBuffer;
    }
}

// Setelah file .docx dibuat docx.js: ganti run penanda [[EQ_xxxx]] dengan equation asli Word (OMML).
async function injectEquationsIntoDocx(blob) {
    if (typeof JSZip === 'undefined') return blob;
    try {
        const zip = await JSZip.loadAsync(blob);
        const f = zip.file('word/document.xml');
        if (!f) return blob;
        let xml = await f.async('string');
        if (!/\[\[EQ_[0-9a-z]+\]\]/.test(xml)) return blob;
        xml = xml.replace(/<w:r>(?:(?!<\/w:r>)[\s\S])*?<w:t(?:\s[^>]*)?>\[\[(EQ_[0-9a-z]+)\]\]<\/w:t><\/w:r>/g, (m, id) => {
            const eq = EDITOR_EQUATIONS['[[' + id + ']]'];
            if (!eq) return m;
            if (eq.omml) return eq.omml;                                   // equation asli Word
            const safe = String(eq.latex || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return m.replace('[[' + id + ']]', safe);                      // cadangan: LaTeX sebagai teks
        });
        zip.file('word/document.xml', xml);
        return await zip.generateAsync({
            type: 'blob',
            mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            compression: 'DEFLATE'
        });
    } catch (err) {
        console.warn('Penanaman equation ke Word dilewati:', err);
        return blob;
    }
}

function safeImageSrc(src) {
    src = String(src || '').trim();
    if (/^data:image\/(?:png|jpe?g|gif|webp|bmp|svg\+xml);base64,[a-z0-9+\/=\s]+$/i.test(src)) return src;
    if (/^https?:\/\//i.test(src)) return src;
    return '';
}

function makeImageToken(src) {
    let token = IMG_TOKEN_CACHE.get(src);
    if (token) return token;
    let h1 = 0x811c9dc5, h2 = 0x01000193 ^ src.length;
    for (let i = 0; i < src.length; i++) {
        const c = src.charCodeAt(i);
        h1 ^= c; h1 = Math.imul(h1, 16777619);
        h2 = Math.imul(h2 ^ c, 2246822519); h2 ^= h2 >>> 13;
    }
    token = '[[IMG_' + (h1 >>> 0).toString(16).padStart(8, '0') + (h2 >>> 0).toString(16).padStart(8, '0') + src.length.toString(36) + ']]';
    IMG_TOKEN_CACHE.set(src, token);
    return token;
}

function replaceImageTokens(html, inline) {
    return String(html || '').replace(/\[\[IMG_([0-9a-z]+)\]\]/g, (m, id) => {
        const src = EDITOR_IMAGES['[[IMG_' + id + ']]'];
        if (!src) return '';
        const safe = String(src).replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        return '<img class="preview-img" src="' + safe + '" alt="Gambar soal" style="display:' + (inline ? 'inline-block' : 'block') + '">';
    }).replace(/\[\[EQ_([0-9a-z]+)\]\]/g, (m, id) => {
        const eq = EDITOR_EQUATIONS['[[EQ_' + id + ']]'];
        if (!eq) return '';
        return '<span class="preview-eq">' + renderEquationHtml(eq.latex) + '</span>';
    });
}

// Tampilkan semua gambar Preview pada 50% dari ukuran aslinya (tetap tidak melebihi lebar kotak).
function applyPreviewImageScale(root) {
    if (!root) return;
    root.querySelectorAll('img').forEach(img => {
        const apply = () => {
            if (img.naturalWidth) {
                img.style.width = Math.max(1, Math.round(img.naturalWidth * PREVIEW_IMAGE_SCALE)) + 'px';
            } else {
                img.style.width = (PREVIEW_IMAGE_SCALE * 100) + '%';
            }
            img.style.maxWidth = '100%';
            img.style.height = 'auto';
        };
        if (img.complete && img.naturalWidth) apply();
        else img.addEventListener('load', apply, { once: true });
    });
}

// Jika AI menghapus token gambar, kembalikan ke posisi soal/opsi yang sama.
function restoreMissingImageTokens(sourceItems, aiItems) {
    if (!Array.isArray(aiItems) || !Array.isArray(sourceItems) || aiItems.length !== sourceItems.length) return aiItems;
    const tokensOf = v => String(v || '').match(/\[\[(?:IMG|EQ)_[0-9a-z]+\]\]/g) || [];
    aiItems.forEach((ai, i) => {
        if (!ai || typeof ai !== 'object') return;
        const src = sourceItems[i] || {};
        const qMiss = tokensOf(src.question).filter(t => !String(ai.question || '').includes(t));
        if (qMiss.length) ai.question = (String(ai.question || '').trim() + ' ' + qMiss.join(' ')).trim();
        if (Array.isArray(src.options) && Array.isArray(ai.options) && src.options.length === ai.options.length) {
            src.options.forEach((o, j) => {
                const miss = tokensOf(o).filter(t => !String(ai.options[j] || '').includes(t));
                if (miss.length) ai.options[j] = (String(ai.options[j] || '').trim() + ' ' + miss.join(' ')).trim();
            });
        }
    });
    return aiItems;
}

let isAiProcessed = false;
let activeQuestionFingerprint = '';
let cacheLoaded = false;
let cacheLookupTimer = null;
let cacheLookupInProgress = false;

function normalizeForFingerprint(value) {
    return String(value ?? '')
        .replace(/\r\n/g, '\n')
        .replace(/\r/g, '\n')
        .replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

function getFingerprintSource(data) {
    return (data || []).map(item => ({
        question: normalizeForFingerprint(item.question),
        options: Array.isArray(item.options) ? item.options.map(normalizeForFingerprint) : [],
        jenisDraft: item.jenis ? String(item.jenis) : '',
        answer: item.answer ? normalizeForFingerprint(item.answer) : ''
    }));
}

async function sha256Hex(text) {
    if (window.crypto && window.crypto.subtle) {
        const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return Array.from(new Uint8Array(buffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    let h1 = 0x811c9dc5, h2 = 0x01000193;
    for (let i = 0; i < text.length; i++) {
        const c = text.charCodeAt(i);
        h1 ^= c; h1 = Math.imul(h1, 16777619);
        h2 ^= c + i; h2 = Math.imul(h2, 16777619);
    }
    return (h1 >>> 0).toString(16).padStart(8,'0') + (h2 >>> 0).toString(16).padStart(8,'0') +
           (text.length >>> 0).toString(16).padStart(8,'0') + '00000000000000000000000000000000';
}

async function getQuestionFingerprint(data = parsedData) {
    const canonical = JSON.stringify(getFingerprintSource(data));
    return await sha256Hex(canonical);
}

function setCacheStatus(message, type = 'muted') {
    const el = document.getElementById('cacheStatus');
    if (!el) return;
    el.className = `small text-${type} mb-2`;
    el.style.display = message ? 'block' : 'none';
    el.innerHTML = message;
}

// Hapus angka "peninggalan batch" yang salah menempel di AKHIR opsi D saja.
// No. 10-20 -> hapus 1; No. 21-30 -> hapus 2; No. 31-40 -> hapus 3; dst.
// Opsi A/B/C/E dan nomor di luar aturan TIDAK diubah.
function cleanTrailingBatchMarker(item) {
    if (!item || !Array.isArray(item.options) || item.options.length < 4) return item;

    const no = Number(item.number || 0);
    const dIndex = 3;
    let d = String(item.options[dIndex] ?? '').trim();

    // Hapus angka sisa yang ditempelkan generator/batch di belakang pilihan D.
    // Prioritaskan marker berdasarkan nomor soal; jika tidak cocok, bersihkan
    // pola nomor batch yang berdiri sendiri di ujung teks.
    let marker = null;
    if (no >= 10 && no <= 20) marker = '1';
    else if (no >= 21) marker = String(Math.floor((no - 1) / 10));

    if (marker !== null) {
        const reMarker = new RegExp('\\s*' + marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*$', 'u');
        d = d.replace(reMarker, '').trim();
    }

    // Tangani sisa nomor batch lain seperti: "Jawaban ... 1", "... 2", dst.
    // Hanya angka yang berdiri sendiri di paling belakang yang dihapus.
    d = d.replace(/\s+(?:[1-9]\d*)\s*$/u, '').trim();
    item.options[dIndex] = d;
    return item;
}

function normalizeAiResult(data) {
    if (!Array.isArray(data)) return [];
    return data.map((item, index) => {
        item = item || {};
        item.number = index + 1;
        item.question = String(item.question || '').replace(/^\d+[\.\)]\s*/, '').trim();
        item.images = Array.isArray(item.images) ? item.images : [];
        return cleanTrailingBatchMarker(item);
    });
}

async function lookupConverterCache(showMiss = false) {
    if (cacheLookupInProgress || !parsedData || parsedData.length === 0 || isAiProcessed) return false;
    cacheLookupInProgress = true;
    try {
        const fingerprint = await getQuestionFingerprint(parsedData);
        activeQuestionFingerprint = fingerprint;
        const fd = new FormData();
        fd.append('action', 'cache_lookup');
        fd.append('fingerprint', fingerprint);
        const csrfName = '<?= $this->security->get_csrf_token_name(); ?>';
        const csrfHash = '<?= $this->security->get_csrf_hash(); ?>';
        if (csrfName) fd.append(csrfName, csrfHash);

        const res = await fetch(window.location.href, { method: 'POST', body: fd });
        const result = await res.json();
        if (result.status === 'hit' && Array.isArray(result.data) && result.data.length) {
            parsedData = normalizeAiResult(result.data);
            isAiProcessed = true;
            cacheLoaded = true;
            document.getElementById('btnAiAnswer').style.display = 'none';
            setCacheStatus(`<i class="fas fa-database mr-1"></i> Hasil ditemukan di cache. ${result.question_count || parsedData.length} soal siap diunduh tanpa convert ulang. <span class="text-muted">${result.cached_at || ''}</span>`, 'success');
            renderPreview();
            return true;
        }
        if (showMiss) setCacheStatus('<i class="fas fa-info-circle mr-1"></i> Belum ada hasil tersimpan. Klik AI Generator untuk memproses.', 'muted');
    } catch (e) {
        console.warn('Cache lookup gagal:', e);
        if (showMiss) setCacheStatus('<i class="fas fa-exclamation-triangle mr-1"></i> Cache server tidak dapat diperiksa. Anda tetap dapat menjalankan AI.', 'warning');
    } finally {
        cacheLookupInProgress = false;
    }
    return false;
}

function scheduleCacheLookup() {
    clearTimeout(cacheLookupTimer);
    cacheLookupTimer = setTimeout(() => lookupConverterCache(false), 900);
}

async function saveConverterCache(fingerprint, data) {
    if (!fingerprint || !Array.isArray(data) || !data.length) return false;
    try {
        const fd = new FormData();
        fd.append('action', 'cache_save');
        fd.append('fingerprint', fingerprint);
        fd.append('payload', JSON.stringify(data));
        const csrfName = '<?= $this->security->get_csrf_token_name(); ?>';
        const csrfHash = '<?= $this->security->get_csrf_hash(); ?>';
        if (csrfName) fd.append(csrfName, csrfHash);
        const res = await fetch(window.location.href, { method: 'POST', body: fd });
        const result = await res.json();
        if (result.status === 'success') {
            setCacheStatus(`<i class="fas fa-database mr-1"></i> Hasil AI tersimpan. Import ulang soal yang sama akan menggunakan cache tanpa convert ulang.`, 'success');
            return true;
        }
    } catch (e) {
        console.warn('Cache save gagal:', e);
    }
    return false;
}

const inputArea = document.getElementById('inputText');
if (inputArea) {
    inputArea.addEventListener('paste', function(e) {
        let clipboardData = e.clipboardData || window.clipboardData;
        if (!clipboardData) return;
        let hasImage = false;

        if (clipboardData.items) {
            for (let i = 0; i < clipboardData.items.length; i++) {
                if (clipboardData.items[i].type.indexOf('image') !== -1) {
                    e.preventDefault();
                    hasImage = true;
                    let blob = clipboardData.items[i].getAsFile();
                    let reader = new FileReader();
                    reader.onload = function(event) { insertImageToInput(event.target.result); };
                    reader.readAsDataURL(blob);
                }
            }
        }
        if (!hasImage) {
            let textData = clipboardData.getData('text/plain');
            if (textData) {
                e.preventDefault();
                textData = textData.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\t]/g, ' ');
                document.execCommand('insertText', false, textData);
            }
        }
        setTimeout(() => autoCleanAndParse(), 100);
    });
}

function insertImageToInput(base64Src) {
    let imgHTML = `<br><img src="${base64Src}" style="max-width:220px; display:block; margin:5px 0;"><br>`;
    document.execCommand('insertHTML', false, imgHTML);
    autoCleanAndParse();
}

function showProgressState(message) {
